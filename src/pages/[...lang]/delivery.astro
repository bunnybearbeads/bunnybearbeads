---
import Layout from '../../layouts/Layout.astro';
import Accent from '../../components/Accent/Accent.astro';
import { getStaticLangPaths, resolveLang, localize, getLocalizedUrl } from '../../utils/i18n';
import deliveryDataRaw from '../../data/pages/delivery.json';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);
const delivery = localize(deliveryDataRaw, currentLang);
---

<Layout lang={currentLang} title={delivery.seo.title} description={delivery.seo.description}>
  <div class="container" style="padding-bottom: 80px;">
    <header class="page-header">
      <div class="welcome-badge">
        <span>📦</span> {delivery.badge}
      </div>
      <h1 class="page-title">{delivery.title}</h1>
      <p class="page-subtitle">{delivery.subtitle}</p>
    </header>

    <div class="features-grid" style="margin-bottom: 48px;">
      {delivery.sections.map((sec: any) => (
        <div class="feature-card" style="text-align: left;">
          <div class="feature-icon" style="margin: 0 0 16px 0;">{sec.icon}</div>
          <h3 style="margin-bottom: 12px;">{sec.heading}</h3>
          <p style="font-size: 15px; color: var(--text-dark); line-height: 1.7;">{sec.text}</p>
        </div>
      ))}
    </div>

    <div class="content-card" style="text-align: center; max-width: 800px; margin: 0 auto;">
      <h2>Need a special <Accent>delivery option</Accent>?</h2>
      <p style="margin: 16px 0 28px;">
        {currentLang === 'ru'
          ? 'Если вам нужна срочная курьерская доставка ко дню рождения или празднику, напишите нам заранее, и мы всё организуем.'
          : currentLang === 'vi'
          ? 'Nếu bạn cần giao hàng hỏa tốc làm quà tặng sinh nhật hay ngày kỷ niệm, hãy nhắn tin ngay cho chúng mình nhé.'
          : 'If you need express rush delivery for an anniversary or special date, contact us directly and we will expedite your order.'}
      </p>
      <a href={getLocalizedUrl('/contacts', currentLang)} class="btn btn-primary">
        <span>💌</span> {currentLang === 'ru' ? 'Связаться с нами' : currentLang === 'vi' ? 'Nhắn tin cho chúng mình' : 'Contact Us'}
      </a>
    </div>
  </div>
</Layout>
