---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/_legacy_PageHeader/PageHeader.astro';
import BlogCard from '../../../components/_legacy_BlogCard/BlogCard.astro';
import { getCollection } from 'astro:content';
import { getStaticLangPaths, resolveLang, useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);
const t = useTranslations(currentLang);

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => post.id.startsWith(`${currentLang}/`))
  .map((post) => {
    const slug = post.id.replace(`${currentLang}/`, '');
    return {
      id: slug,
      data: post.data,
    };
  })
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout
  lang={currentLang}
  title={`${t('blog.title')} — BunnyBearBeads`}
  description={t('blog.subtitle')}
>
  <div class="container page-container">
    <PageHeader title={t('blog.title')} subtitle={t('blog.subtitle')} />

    <div class="blog-grid">
      {posts.map((post) => (
        <BlogCard
          id={post.id}
          data={post.data}
          currentLang={currentLang}
        />
      ))}
    </div>
  </div>
</Layout>
