---
import Layout from '../../../layouts/Layout.astro';
import Accent from '../../../components/Accent/Accent.astro';
import { getCollection, render } from 'astro:content';
import { resolveLang, getLocalizedUrl } from '../../../utils/i18n';
import { useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    // post.id is e.g. "ru/art-of-japanese-miyuki" or "en/art-of-japanese-miyuki"
    const [lang, ...slugParts] = post.id.split('/');
    const slug = slugParts.join('/');
    return {
      params: {
        lang: lang === 'en' ? undefined : lang,
        id: slug,
      },
      props: { post },
    };
  });
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);
const t = useTranslations(currentLang);

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  lang={currentLang}
  title={`${post.data.title} — BunnyBearBeads`}
  description={post.data.excerpt}
>
  <div class="container" style="padding-top: 30px; padding-bottom: 80px; max-width: 860px;">
    <div style="margin-bottom: 24px;">
      <a href={getLocalizedUrl('/blog', currentLang)} style="color: var(--color-nav-link); text-decoration: none; font-weight: 600;">
        ← {t('blog.back_to_blog')}
      </a>
    </div>

    <article class="content-card" style="padding: 48px 40px;">
      <div class="blog-meta" style="margin-bottom: 16px;">
        <span>{t('blog.published_on')} {post.data.date}</span> • <span>{post.data.author}</span>
      </div>

      <h1 style="font-size: 42px; line-height: 1.2; margin-bottom: 24px; color: var(--color-brand-dark);">
        {post.data.title}
      </h1>

      {post.data.coverImage && (
        <div style="border-radius: var(--radius-md); overflow: hidden; margin-bottom: 32px; box-shadow: var(--shadow-soft);">
          <img
            src={post.data.coverImage}
            alt={post.data.title}
            style="width: 100%; height: auto; display: block;"
          />
        </div>
      )}

      <p style="font-size: 19px; line-height: 1.8; color: var(--color-brand-dark); margin-bottom: 24px; font-weight: 500;">
        {post.data.excerpt}
      </p>

      <div class="blog-body" style="font-size: 16.5px; line-height: 1.85; color: var(--text-dark);">
        <Content />
      </div>

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="materials-tags" style="margin-top: 36px; padding-top: 20px; border-top: 1px solid rgba(0,0,0,0.06);">
          {post.data.tags.map((tag: string) => (
            <span class="material-tag">#{tag}</span>
          ))}
        </div>
      )}

      <div class="cta-buttons" style="margin-top: 36px;">
        <a href={getLocalizedUrl('/catalog', currentLang)} class="btn btn-primary">
          <span>✨</span> {currentLang === 'ru' ? 'Смотреть каталог изделий' : currentLang === 'vi' ? 'Xem các mẫu trang sức' : 'Explore Jewelry Catalog'}
        </a>
      </div>
    </article>
  </div>
</Layout>

<style>
  .blog-body :global(p) {
    margin-bottom: 20px;
  }
  .blog-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
