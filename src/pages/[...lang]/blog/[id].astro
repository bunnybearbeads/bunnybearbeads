---
import Layout from '../../../layouts/Layout.astro';
import BlogArticle from '../../../components/_legacy_BlogArticle/BlogArticle.astro';
import { getCollection, render } from 'astro:content';
import { resolveLang } from '../../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const [lang, ...slugParts] = post.id.split('/');
    const slug = slugParts.join('/');
    return {
      params: {
        lang: lang === 'en' ? undefined : lang,
        id: slug,
      },
      props: { post },
    };
  });
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  lang={currentLang}
  title={`${post.data.title} — BunnyBearBeads`}
  description={post.data.excerpt}
>
  <BlogArticle data={post.data} currentLang={currentLang}>
    <Content />
  </BlogArticle>
</Layout>
