---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/_legacy_PageHeader/PageHeader.astro';
import FaqItem from '../../components/_legacy_FaqItem/FaqItem.astro';
import { getCollection, render } from 'astro:content';
import { getStaticLangPaths, resolveLang, getLocalizedUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);
const t = useTranslations(currentLang);

const allFaqEntries = await getCollection('faq');
const langEntries = allFaqEntries
  .filter((entry) => entry.id.startsWith(`${currentLang}/`))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const renderedItems = await Promise.all(
  langEntries.map(async (entry) => {
    const rendered = await render(entry);
    return {
      entry,
      Content: rendered.Content,
    };
  })
);
---

<Layout lang={currentLang} title={t('faq.seo_title')} description={t('faq.seo_desc')}>
  <div class="container page-container">
    <PageHeader title={t('faq.title')} subtitle={t('faq.subtitle')} />

    <div class="faq-list">
      {renderedItems.map(({ entry, Content }) => (
        <FaqItem icon={entry.data.icon} question={entry.data.question}>
          <Content />
        </FaqItem>
      ))}
    </div>

    <div class="content-card faq-cta-card">
      <h2>{t('faq.cta_heading')}</h2>
      <p>{t('faq.cta_text')}</p>
      <div class="cta-buttons">
        <a href={getLocalizedUrl('/contacts', currentLang)} class="btn btn-primary">
          💌 {t('faq.cta_contact')}
        </a>
        <a href={getLocalizedUrl('/catalog', currentLang)} class="btn btn-secondary">
          ✨ {t('faq.cta_catalog')}
        </a>
      </div>
    </div>
  </div>
</Layout>
