---
import Layout from '../../layouts/Layout.astro';
import Accent from '../../components/Accent/Accent.astro';
import { getStaticLangPaths, resolveLang, localize, getLocalizedUrl } from '../../utils/i18n';
import whereToBuyDataRaw from '../../data/pages/where-to-buy.json';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);
const page = localize(whereToBuyDataRaw, currentLang);
---

<Layout lang={currentLang} title={page.seo.title} description={page.seo.description}>
  <div class="container" style="padding-bottom: 80px;">
    <header class="page-header">
      <div class="welcome-badge">
        <span>📍</span> {page.badge}
      </div>
      <h1 class="page-title">{page.title}</h1>
      <p class="page-subtitle">{page.subtitle}</p>
    </header>

    <div class="features-grid" style="margin-bottom: 48px;">
      {page.locations.map((loc: any) => (
        <div class="feature-card" style="text-align: left; display: flex; flex-direction: column;">
          <div class="feature-icon" style="margin: 0 0 16px 0;">{loc.icon}</div>
          <h3 style="margin-bottom: 6px;">{loc.title}</h3>
          <div style="font-size: 13px; font-weight: 700; color: var(--accent-teal); margin-bottom: 8px;">
            {loc.city}
          </div>
          <p style="font-size: 14px; font-weight: 600; color: var(--color-brand-dark); margin-bottom: 4px;">
            {loc.address}
          </p>
          <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 16px;">
            ⏰ {loc.schedule}
          </p>
          <p style="font-size: 14.5px; color: var(--text-dark); line-height: 1.6; margin-top: auto;">
            {loc.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- Booking / Contact Card -->
    <div class="content-card" style="text-align: center; max-width: 800px; margin: 0 auto;">
      <h2>
        {currentLang === 'ru'
          ? 'Хотите примерить или заказать украшение вживую?'
          : currentLang === 'vi'
          ? 'Bạn muốn ghé thăm và thử trang sức trực tiếp?'
          : 'Want to visit our studio or arrange a private fitting?'}
      </h2>
      <p style="margin: 16px 0 28px; font-size: 16px;">
        {currentLang === 'ru'
          ? 'Напишите нам в Telegram или Instagram, чтобы согласовать удобное время визита в студию или уточнить наличие украшений.'
          : currentLang === 'vi'
          ? 'Hãy nhắn tin qua Telegram hoặc Instagram để đặt lịch ghé thăm xưởng hoặc kiểm tra các mẫu có sẵn nhé.'
          : 'Drop us a friendly note on Telegram or Instagram to arrange an appointment or inquire about currently available stock.'}
      </p>
      <div class="cta-buttons" style="justify-content: center;">
        <a href="https://t.me/bunnybearbeads" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <span>✈️</span> Telegram @bunnybearbeads
        </a>
        <a href={getLocalizedUrl('/contacts', currentLang)} class="btn btn-secondary">
          <span>💌</span> {currentLang === 'ru' ? 'Все контакты' : currentLang === 'vi' ? 'Xem các kênh liên hệ' : 'All Contacts'}
        </a>
      </div>
    </div>
  </div>
</Layout>
