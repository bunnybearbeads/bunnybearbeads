---
import Layout from '../../../layouts/Layout.astro';
import Product from '../../../components/Product/Product.astro';
import { SUPPORTED_LANGUAGES, resolveLang, localize } from '../../../i18n/utils';
import { getProducts, getDefaultVariant, resolveVariant } from '../../../utils/products';

export async function getStaticPaths() {
  const products = await getProducts();
  return SUPPORTED_LANGUAGES.flatMap((lang) =>
    products.map((product) => ({
      params: {
        lang: lang === 'en' ? undefined : lang,
        id: product.id,
      },
      props: { entry: product },
    }))
  );
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);

const { entry } = Astro.props;
const product = localize(resolveVariant(entry, getDefaultVariant(entry)), currentLang);
---

<Layout
  lang={currentLang}
  title={`${product.title} — BunnyBearBeads`}
  description={product.description}
>
  <Product entry={entry} currentLang={currentLang} />
</Layout>
