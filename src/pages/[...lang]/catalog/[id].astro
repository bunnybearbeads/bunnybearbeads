---
import Layout from '../../../layouts/Layout.astro';
import Accent from '../../../components/Accent/Accent.astro';
import { getCollection } from 'astro:content';
import { SUPPORTED_LANGUAGES, resolveLang, localize, getLocalizedUrl } from '../../../utils/i18n';
import { useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return SUPPORTED_LANGUAGES.flatMap((lang) =>
    products.map((product) => ({
      params: {
        lang: lang === 'en' ? undefined : lang,
        id: product.id,
      },
      props: { productRaw: product },
    }))
  );
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);
const t = useTranslations(currentLang);

const { productRaw } = Astro.props;
const product = localize(productRaw.data, currentLang);

// Find partner stock locations to compute days since checkup
const ngayMaiLoc = productRaw.data.stockLocations?.find(
  (l: any) => l.city?.toLowerCase().includes('da nang') || l.location?.includes('NGÀY MAI')
);
const catFoodLoc = productRaw.data.stockLocations?.find(
  (l: any) => l.location?.includes('Cat Food') || l.city?.toLowerCase().includes('ho chi minh')
);

// Format relative days text (e.g. "2 дня", "3 days", "2 ngày")
function getElapsedDaysText(checkDateStr?: string, lang: string = 'ru') {
  if (!checkDateStr) {
    if (lang === 'en') return 'a few days';
    if (lang === 'vi') return 'vài ngày';
    return 'пару дней';
  }
  const checkDate = new Date(checkDateStr);
  const now = new Date('2026-10-07'); // project current reference date
  const diffTime = Math.max(0, now.getTime() - checkDate.getTime());
  const diffDays = Math.max(1, Math.round(diffTime / (1000 * 60 * 60 * 24)));

  if (lang === 'en') {
    return diffDays === 1 ? '1 day' : `${diffDays} days`;
  }
  if (lang === 'vi') {
    return `${diffDays} ngày`;
  }
  // Russian pluralization
  if (diffDays % 10 === 1 && diffDays % 100 !== 11) {
    return `${diffDays} день`;
  } else if ([2, 3, 4].includes(diffDays % 10) && ![12, 13, 14].includes(diffDays % 100)) {
    return `${diffDays} дня`;
  } else {
    return `${diffDays} дней`;
  }
}

const nmDaysText = getElapsedDaysText(ngayMaiLoc?.lastCheckedAt, currentLang);
const cfDaysText = getElapsedDaysText(catFoodLoc?.lastCheckedAt, currentLang);

function localizeCity(cityStr: string = '') {
  const c = cityStr.toLowerCase();
  if (c.includes('da lat')) return t('geo.city.dalat');
  if (c.includes('da nang')) return t('geo.city.danang');
  if (c.includes('ho chi minh')) return t('geo.city.hcm');
  return cityStr;
}

function localizeDistrict(distStr: string = '') {
  const d = distStr.toLowerCase();
  if (d.includes('lâm viên') || d.includes('lam vien')) return t('geo.district.lamvien');
  if (d.includes('my an') || d.includes('mỹ an')) return t('geo.district.myan');
  if (d.includes('ben than') || d.includes('bến thành') || d.includes('ben thanh')) return t('geo.district.benthanh');
  return distStr;
}
---

<Layout
  lang={currentLang}
  title={`${product.title} — BunnyBearBeads`}
  description={product.description}
>
  <div class="container" style="padding-top: 30px; padding-bottom: 80px;">
    <div style="margin-bottom: 24px;">
      <a href={getLocalizedUrl('/catalog', currentLang)} style="color: var(--color-nav-link); text-decoration: none; font-weight: 600;">
        ← {t('catalog.back_to_catalog')}
      </a>
    </div>

    <div class="product-detail-grid">
      <!-- Gallery / Image -->
      <div class="product-gallery">
        {product.images && product.images.length > 0 ? (
          <img
            src={product.images[0]}
            alt={product.title}
            loading="eager"
          />
        ) : (
          <div style="height: 480px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(212, 163, 89, 0.16) 0%, rgba(42, 123, 136, 0.14) 100%);">
            <span style="font-size: 80px; margin-bottom: 12px; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.1));">📿</span>
            <span style="font-family: var(--font-serif); font-size: 20px; color: var(--color-brand-dark); font-style: italic;">BunnyBearBeads Masterpiece</span>
          </div>
        )}
      </div>

      <!-- Info Panel -->
      <div class="product-info-panel">
        <span class="product-category">{product.category}</span>
        <h1>{product.title}</h1>

        {product.description && (
          <p class="product-description-text">
            {product.description}
          </p>
        )}

        <div class="product-price-large">{Number(product.price).toLocaleString('vi-VN')} {product.currency || 'VND'}</div>

        <!-- Where to Buy section -->
        <div class="where-to-buy-section">
          <div class="section-subtitle-badge">
            <span class="badge-dot"></span>
            <span>{t('catalog.where_to_buy')}</span>
          </div>

          <div class="buy-options-list">
            {productRaw.data.stockLocations && productRaw.data.stockLocations.length > 0 ? (
              (() => {
                const dalatOffline = productRaw.data.stockLocations.find(
                  (l: any) => l.type === 'offline' && l.city?.toLowerCase().includes('da lat')
                );
                const otherOffline = productRaw.data.stockLocations.filter(
                  (l: any) => l.type === 'offline' && !l.city?.toLowerCase().includes('da lat')
                );
                const hasOnline = productRaw.data.stockLocations.some((l: any) => l.type === 'online');

                const items: any[] = [];

                // 1. Da Lat offline (if present)
                if (dalatOffline) {
                  items.push({ kind: 'offline', loc: dalatOffline });
                }

                // 2. Split delivery options (placed right after Da Lat, or first if no Da Lat offline)
                if (hasOnline) {
                  items.push({
                    kind: 'delivery',
                    icon: '🛵',
                    title: t('catalog.delivery_dalat_title'),
                    sub: t('catalog.delivery_dalat_sub'),
                  });
                  items.push({
                    kind: 'delivery',
                    icon: '📦',
                    title: t('catalog.delivery_vn_title'),
                    sub: t('catalog.delivery_vn_sub'),
                  });
                }

                // 3. Other offline partner stores
                otherOffline.forEach((loc: any) => {
                  items.push({ kind: 'offline', loc });
                });

                return items.map((item: any) => {
                  if (item.kind === 'delivery') {
                    return (
                      <div class="buy-option-card online">
                        <div class="buy-option-icon">{item.icon}</div>
                        <div class="buy-option-content">
                          <div class="buy-option-title">
                            <div class="delivery-text-wrap">
                              <strong>{item.title}</strong>
                              <span class="buy-option-delivery-sub">{item.sub}</span>
                            </div>
                          </div>
                        </div>
                        <span class="stock-type-tag online">
                          <span class="tag-status-indicator"></span>
                          {t('catalog.delivery_badge')}
                        </span>
                      </div>
                    );
                  }

                  const loc = item.loc;
                  const isOfflineCheckup = loc.type === 'offline' && loc.lastCheckedAt;
                  const modalTarget = isOfflineCheckup
                    ? (loc.city.toLowerCase().includes('da nang') || (loc.location && loc.location.includes('NGÀY MAI'))
                        ? '#modal-checkup-ngaymai'
                        : '#modal-checkup-catfood')
                    : undefined;

                  return (
                    <div
                      class:list={[
                        'buy-option-card',
                        loc.type,
                        modalTarget && 'buy-option-card--clickable',
                      ]}
                      data-hystmodal={modalTarget}
                      role={modalTarget ? 'button' : undefined}
                      tabindex={modalTarget ? 0 : undefined}
                      title={modalTarget ? t('catalog.weekly_audit_hint') : undefined}
                    >
                      <div class="buy-option-icon">📍</div>
                      <div class="buy-option-content">
                        <div class="buy-option-title">
                          {loc.location && loc.location.includes('магазин') ? (
                            (() => {
                              const parts = loc.location.split('магазин');
                              const rawDistrict = parts[0].replace(/,\s*$/, '').trim();
                              const district = localizeDistrict(rawDistrict);
                              const shop = parts[1] ? parts[1].trim() : '';
                              return (
                                <>
                                  <strong>{localizeCity(loc.city)}{district ? `, ${district}` : ''}</strong>, {t('catalog.shop_word')} <strong>{shop}</strong>
                                </>
                              );
                            })()
                          ) : (
                            <>
                              <strong>{localizeCity(loc.city)}{loc.location ? `, ${localizeDistrict(loc.location)}` : ''}</strong>
                            </>
                          )}
                        </div>
                        <div class="buy-option-meta">
                          {loc.quantity !== undefined && (
                            loc.lastCheckedAt ? (
                              <span class="stock-quantity-pill stock-quantity-pill--clickable">
                                <strong>{loc.quantity} {t('catalog.pcs')}</strong>
                                <span class="audit-prep"> {t('catalog.as_of')} </span>
                                <span class="audit-date">{loc.lastCheckedAt}</span>
                                <span class="pill-info-icon" aria-hidden="true">ℹ️</span>
                              </span>
                            ) : (
                              <span class="stock-quantity-pill">
                                <strong>{loc.quantity} {t('catalog.pcs')}</strong>
                              </span>
                            )
                          )}
                        </div>
                      </div>
                      <span class:list={['stock-type-tag', loc.type]}>
                        <span class="tag-status-indicator"></span>
                        {loc.type === 'offline' ? t('catalog.offline_badge') : t('catalog.delivery_badge')}
                      </span>
                    </div>
                  );
                });
              })()
            ) : (
              <div class="buy-option-card remake">
                <div class="buy-option-icon">✨</div>
                <div class="buy-option-content">
                  <div class="buy-option-title">
                    <strong>{t('catalog.remake_order')}</strong>
                  </div>
                  <div class="buy-option-hint">
                    Товара сейчас нет в наличии, но мы с радостью сделаем его специально для вас!
                  </div>
                </div>
                <button type="button" class="btn-remake-action">
                  {t('catalog.remake_order')}
                </button>
              </div>
            )}
          </div>
        </div>

        <!-- Materials Section -->
        <div class="product-specs-section">
          <strong class="specs-heading">
            {t('catalog.materials_label')}
          </strong>
          {productRaw.data.materialsHtml ? (
            <div class="materials-html-content" set:html={productRaw.data.materialsHtml} />
          ) : product.materials && product.materials.length > 0 ? (
            <div class="materials-tags">
              {product.materials.map((mat: string) => (
                <span class="material-tag">{mat}</span>
              ))}
            </div>
          ) : null}
        </div>

        <!-- Credits Section -->
        <div class="product-specs-section credits-section">
          <strong class="specs-heading">
            {t('catalog.credits')}
          </strong>
          <div class="credits-box">
            <div class="credit-row">
              <span class="credit-label">{t('catalog.crafted_by')}:</span>
              <strong class="credit-val brand-craft">BunnyBearBeads</strong>
            </div>
            {productRaw.data.designedBy && (
              <div class="credit-row">
                <span class="credit-label">{t('catalog.designed_by')}:</span>
                <span class="credit-val" set:html={productRaw.data.designedBy} />
              </div>
            )}
          </div>
        </div>

        <div class="cta-buttons" style="margin-top: 32px; display: flex; gap: 16px; flex-wrap: wrap;">
          <a
            href="https://t.me/bunnybearbeads"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
            style="padding: 16px 36px; font-size: 16px; display: inline-flex; align-items: center; gap: 10px;"
          >
            <span>✈️</span> {t('catalog.order_piece')} (Telegram)
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- ====================================================================
       HystModal Windows for Offline Partner Checkups
       ==================================================================== -->
  <!-- Modal: NGÀY MAI (Da Nang) -->
  <div class="hystmodal" id="modal-checkup-ngaymai" aria-hidden="true">
    <div class="hystmodal__wrap">
      <div class="hystmodal__window checkup-modal-window" role="dialog" aria-modal="true" aria-labelledby="modal-nm-title">
        <button data-hystclose class="hystmodal__close" aria-label={t('catalog.modal.close')}>✕</button>

        <div class="modal-badge-tag">
          <span>📍</span>
          <span>{localizeCity('Da Nang')} • NGÀY MAI</span>
        </div>

        <h3 id="modal-nm-title" class="modal-headline">
          {t('catalog.modal.title')}
        </h3>

        <div class="modal-body-content">
          <p class="modal-lead">
            {t('catalog.modal.nm_p1')}
          </p>
          <p>
            {t('catalog.modal.nm_p2')}
          </p>
          <p set:html={t('catalog.modal.nm_p2_sub').replace('{item}', `<strong>«${product.title}»</strong>`)} />
          <p class="modal-highlight">
            {t('catalog.modal.nm_p3')}
          </p>
        </div>

        <div class="modal-stock-photo-card">
          <div class="stock-photo-header">
            <span class="stock-photo-icon">📸</span>
            <strong class="stock-photo-heading">{t('catalog.modal.stock_photo_title')} {ngayMaiLoc?.lastCheckedAt || '2026-10-04'}</strong>
          </div>
          <a
            href="/images/stock/ngay-mai-showcase.jpg"
            target="_blank"
            rel="noopener noreferrer"
            class="stock-photo-frame"
            title={t('catalog.modal.photo_zoom_hint')}
          >
            <img
              src="/images/stock/ngay-mai-showcase.jpg"
              alt={`Витрина с украшениями в NGÀY MAI (${ngayMaiLoc?.lastCheckedAt || '2026-10-04'})`}
              class="stock-photo-image"
              loading="lazy"
            />
            <span class="stock-photo-zoom-tag">🔍 {t('catalog.modal.photo_zoom_badge')}</span>
          </a>
        </div>

        <div class="modal-hours">
          <span class="modal-hours-icon">🕒</span>
          <span>{t('catalog.modal.nm_hours')}</span>
        </div>

        <div class="modal-footer-actions">
          <a
            href="https://maps.app.goo.gl/9ZpC4aK4fGzW5c8r7"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-maps-link"
          >
            <span>🗺️</span>
            <strong>{t('catalog.modal.nm_maps')}</strong>
            <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Cat Food (Ho Chi Minh City) -->
  <div class="hystmodal" id="modal-checkup-catfood" aria-hidden="true">
    <div class="hystmodal__wrap">
      <div class="hystmodal__window checkup-modal-window" role="dialog" aria-modal="true" aria-labelledby="modal-cf-title">
        <button data-hystclose class="hystmodal__close" aria-label={t('catalog.modal.close')}>✕</button>

        <div class="modal-badge-tag">
          <span>📍</span>
          <span>{localizeCity('Ho Chi Minh')} • Cat Food</span>
        </div>

        <h3 id="modal-cf-title" class="modal-headline">
          {t('catalog.modal.title')}
        </h3>

        <div class="modal-body-content">
          <p class="modal-lead">
            {t('catalog.modal.catfood_p1')}
          </p>
          <p>
            {t('catalog.modal.catfood_p2')}
          </p>
          <p class="modal-highlight">
            {t('catalog.modal.catfood_p3')}
          </p>
        </div>

        <div class="modal-footer-actions">
          <a
            href="https://maps.google.com/?q=Cat+Food+Shop+Ben+Thanh+Ho+Chi+Minh+City"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-maps-link"
          >
            <span>🗺️</span>
            <strong>{t('catalog.modal.catfood_maps')}</strong>
            <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .product-description-text {
    font-size: 16px;
    color: var(--text-dark);
    line-height: 1.8;
    margin-bottom: 24px;
    padding: 0;
    background: none;
  }

  .where-to-buy-section {
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(212, 163, 89, 0.25);
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 28px;
    box-shadow: 0 4px 14px rgba(61, 46, 36, 0.04);
  }

  .section-subtitle-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--color-brand-dark);
    margin-bottom: 14px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-teal);
    display: inline-block;
  }

  .buy-options-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .buy-option-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
    padding: 12px 16px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .buy-option-card:hover {
    border-color: var(--accent-gold);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .buy-option-card--clickable {
    cursor: pointer;
  }

  .buy-option-card--clickable:hover {
    border-color: var(--accent-gold);
    box-shadow: 0 4px 14px rgba(61, 46, 36, 0.09);
    transform: translateY(-1px);
  }

  .buy-option-icon {
    font-size: 20px;
    line-height: 1;
  }

  .buy-option-content {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .buy-option-title {
    font-size: 14px;
    color: var(--color-brand-dark);
  }

  .delivery-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .buy-option-delivery-sub {
    font-size: 13px;
    font-weight: 400;
    color: var(--text-muted);
    line-height: 1.35;
  }

  .buy-option-hint {
    font-size: 12px;
    color: var(--text-muted);
    width: 100%;
  }

  .buy-option-meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .stock-quantity-pill {
    font-size: 12px;
    padding: 3px 10px;
    background: rgba(42, 123, 136, 0.12);
    color: var(--accent-teal);
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .stock-quantity-pill strong {
    font-weight: 700;
  }

  .stock-quantity-pill .audit-prep {
    font-weight: 400;
    opacity: 0.85;
    margin: 0 3px;
  }

  .stock-quantity-pill .audit-date {
    font-weight: 600;
  }

  .stock-audit-pill {
    font-size: 11.5px;
    font-weight: 500;
    padding: 2px 8px;
    background: rgba(100, 116, 139, 0.1);
    color: #475569;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border: 1px dashed rgba(100, 116, 139, 0.25);
  }

  .audit-icon {
    font-size: 11px;
    line-height: 1;
  }

  /* Distinct visual badges (non-clickable tags) */
  .stock-type-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    white-space: nowrap;
    user-select: none;
    pointer-events: none; /* distinctly non-clickable */
  }

  .tag-status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }

  /* Offline Tag: Warm Terracotta / Amber / Coral styling */
  .stock-type-tag.offline {
    background: #FFF4E5;
    color: #B25E09;
    border: 1px solid rgba(178, 94, 9, 0.25);
  }

  .stock-type-tag.offline .tag-status-indicator {
    background: #D97706;
    box-shadow: 0 0 6px rgba(217, 119, 6, 0.5);
  }

  /* Online Tag: Cool Emerald / Sage / Forest styling */
  .stock-type-tag.online {
    background: #ECFDF5;
    color: #047857;
    border: 1px solid rgba(4, 120, 87, 0.25);
  }

  .stock-type-tag.online .tag-status-indicator {
    background: #10B981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.5);
  }

  /* Remake button for when product is out of stock */
  .btn-remake-action {
    background: var(--color-brand-dark);
    color: #FAF7F2;
    border: 1px solid var(--color-brand-dark);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    cursor: default;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-remake-action:hover {
    background: var(--accent-gold);
    border-color: var(--accent-gold);
  }

  .product-specs-section {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .specs-heading {
    display: block;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--text-muted);
    margin-bottom: 10px;
  }

  .materials-html-content {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--color-brand-dark);
    background: rgba(255, 255, 255, 0.6);
    padding: 14px 18px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .materials-html-content :global(.mat-beads) {
    font-weight: 600;
    color: var(--color-brand-dark);
  }

  .materials-html-content :global(.mat-colors) {
    color: var(--accent-teal);
    font-size: 13.5px;
  }

  .materials-html-content :global(.mat-accessory) {
    color: var(--text-muted);
    font-style: italic;
  }

  .credits-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: rgba(255, 255, 255, 0.6);
    padding: 14px 18px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .credit-row {
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .credit-label {
    color: var(--text-muted);
  }

  .brand-craft {
    color: var(--accent-teal);
    font-weight: 700;
  }

