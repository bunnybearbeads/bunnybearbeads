---
import Layout from '../../../layouts/Layout.astro';
import ProductDetail from '../../../components/_legacy_ProductDetail/ProductDetail.astro';
import { getCollection } from 'astro:content';
import { SUPPORTED_LANGUAGES, resolveLang, localize } from '../../../i18n/utils';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return SUPPORTED_LANGUAGES.flatMap((lang) =>
    products.map((product) => ({
      params: {
        lang: lang === 'en' ? undefined : lang,
        id: product.id,
      },
      props: { productRaw: product },
    }))
  );
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);

const { productRaw } = Astro.props;
const product = localize(productRaw.data, currentLang);
---

<Layout
  lang={currentLang}
  title={`${product.title} — BunnyBearBeads`}
  description={product.description}
>
  <ProductDetail
    product={product}
    productRaw={productRaw}
    currentLang={currentLang}
  />
</Layout>
