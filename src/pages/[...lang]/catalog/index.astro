---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/_legacy_PageHeader/PageHeader.astro';
import CatalogFilters from '../../../components/_legacy_CatalogFilters/CatalogFilters.astro';
import ProductCard from '../../../components/_legacy_ProductCard/ProductCard.astro';
import { getCollection } from 'astro:content';
import { getStaticLangPaths, resolveLang, localize, useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);
const t = useTranslations(currentLang);

const rawProducts = await getCollection('products');
const sortedProducts = [...rawProducts].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const products = sortedProducts.map((p) => ({
  id: p.id,
  categoryId: p.data.categoryId || 'bracelets',
  data: localize(p.data, currentLang),
}));

const categories = [
  { id: 'all', label: t('cat.all') },
  { id: 'bracelets', label: t('cat.bracelets') },
  { id: 'rings', label: t('cat.rings') },
  { id: 'phone-charms', label: t('cat.phone_charms') },
  { id: 'keychains', label: t('cat.keychains') },
  { id: 'other', label: t('cat.other') },
];
---

<Layout
  lang={currentLang}
  title={`${t('catalog.title')} — BunnyBearBeads`}
  description={t('catalog.subtitle')}
>
  <div class="container page-container">
    <PageHeader title={t('catalog.title')} subtitle={t('catalog.subtitle')} />

    <CatalogFilters categories={categories} />

    <div class="products-grid" id="products-grid">
      {products.map((product) => (
        <ProductCard
          id={product.id}
          categoryId={product.categoryId}
          data={product.data}
          currentLang={currentLang}
        />
      ))}
    </div>
  </div>
</Layout>
