---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/_legacy_PageHeader/PageHeader.astro';
import { getEntry, render } from 'astro:content';
import { getStaticLangPaths, resolveLang } from '../../i18n/utils';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);

const aboutEntry = await getEntry('about', currentLang);
if (!aboutEntry) {
  throw new Error(`About entry not found for lang: ${currentLang}`);
}

const { Content } = await render(aboutEntry);
---

<Layout lang={currentLang} title={aboutEntry.data.seoTitle} description={aboutEntry.data.seoDesc}>
  <div class="container page-container">
    <PageHeader
      title={aboutEntry.data.title}
      subtitleHtml={aboutEntry.data.subtitle}
    />

    <article class="content-card">
      <Content />
    </article>
  </div>
</Layout>
