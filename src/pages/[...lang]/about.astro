---
import Layout from '../../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { getStaticLangPaths, resolveLang } from '../../utils/i18n';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);

// Get markdown entry for the current language
const aboutEntry = await getEntry('about', currentLang);

if (!aboutEntry) {
  throw new Error(`About entry not found for lang: ${currentLang}`);
}

const { Content } = await render(aboutEntry);
---

<Layout lang={currentLang} title={aboutEntry.data.seoTitle} description={aboutEntry.data.seoDesc}>
  <div class="container" style="padding-bottom: 80px;">
    <header class="page-header">
      <h1 class="page-title">{aboutEntry.data.title}</h1>
      <p class="page-subtitle" set:html={aboutEntry.data.subtitle} />
    </header>

    <article class="content-card">
      <Content />
    </article>
  </div>
</Layout>
