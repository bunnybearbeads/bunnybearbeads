---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/_legacy_Hero/Hero.astro';
import FeaturesSection from '../../components/_legacy_FeaturesSection/FeaturesSection.astro';
import { getEntry, render } from 'astro:content';
import { getStaticLangPaths, resolveLang } from '../../i18n/utils';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);

const homeEntry = await getEntry('home', currentLang);
if (!homeEntry) {
  throw new Error(`Home entry not found for lang: ${currentLang}`);
}

const { hero, features, featuresTitle, featuresSubtitle, seoTitle, seoDesc } = homeEntry.data;
const { Content } = await render(homeEntry);
---

<Layout lang={currentLang} title={seoTitle} description={seoDesc}>
  <Hero hero={hero} currentLang={currentLang}>
    <Content />
  </Hero>

  <FeaturesSection
    title={featuresTitle}
    subtitle={featuresSubtitle}
    features={features}
  />
</Layout>
