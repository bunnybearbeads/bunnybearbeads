---
import Layout from '../../layouts/Layout.astro';
import Accent from '../../components/Accent/Accent.astro';
import { getStaticLangPaths, resolveLang, localize, getLocalizedUrl } from '../../utils/i18n';
import homeDataRaw from '../../data/pages/home.json';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);
const home = localize(homeDataRaw, currentLang);
---

<Layout lang={currentLang} title={home.seo.title} description={home.seo.description}>
  <!-- Hero Section -->
  <section class="hero-section" id="welcome">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="welcome-badge">
            <span>📿</span> {home.hero.badge}
          </div>

          <h1 class="hero-title">
            {home.hero.titlePrefix}<Accent>{home.hero.titleAccent}</Accent>
          </h1>

          <div class="welcome-card">
            <div class="welcome-text">
              <p>
                <strong>{home.hero.authorGreeting}</strong>, {home.hero.authorTagline}
              </p>
              <p>{home.hero.authorP1}</p>
              <p>{home.hero.authorP2}</p>
            </div>

            <div class="author-signature">
              <div class="author-avatar">
                <img src="/logo_icon.png" alt={home.hero.authorName} width="52" height="52" />
              </div>
              <div class="author-info">
                <h4>{home.hero.authorName}</h4>
                <p>{home.hero.authorRole}</p>
              </div>
            </div>
          </div>

          <div class="cta-buttons">
            <a href={getLocalizedUrl('/catalog', currentLang)} class="btn btn-primary">
              <span>✨</span> {home.hero.btnExplore}
            </a>
            <a href={getLocalizedUrl('/contacts', currentLang)} class="btn btn-secondary">
              <span>💌</span> {home.hero.btnOrder}
            </a>
          </div>
        </div>

        <div class="hero-image-wrapper">
          <div class="image-frame">
            <img
              src="/beadwork_hero.png"
              alt="Handcrafted beadwork jewelry art by BunnyBearBeads"
              width="600"
              height="600"
              loading="eager"
            />
          </div>
          <div class="floating-badge">
            <span class="floating-badge-icon">💎</span>
            <div class="floating-badge-text">
              <h5>{home.hero.badgeCrafted}</h5>
              <p>{home.hero.badgeUnique}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features-section" id="features">
    <div class="container">
      <h2 class="section-title">{home.features.title}</h2>
      <p class="section-subtitle">{home.features.subtitle}</p>

      <div class="features-grid">
        {home.features.items.map((item: any) => (
          <div class="feature-card">
            <div class="feature-icon">{item.icon}</div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
