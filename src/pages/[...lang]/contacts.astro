---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/_legacy_PageHeader/PageHeader.astro';
import ContactsSection from '../../components/_legacy_ContactsSection/ContactsSection.astro';
import { getEntry, render } from 'astro:content';
import { getStaticLangPaths, resolveLang } from '../../i18n/utils';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);

const contactsEntry = await getEntry('contacts', currentLang);
if (!contactsEntry) {
  throw new Error(`Contacts entry not found for lang: ${currentLang}`);
}

const { title, subtitle, introHeading, telegramBox, channels, seoTitle, seoDesc } = contactsEntry.data;
const { Content } = await render(contactsEntry);
---

<Layout lang={currentLang} title={seoTitle} description={seoDesc}>
  <div class="container page-container">
    <PageHeader title={title} subtitle={subtitle} />

    <ContactsSection
      introHeading={introHeading}
      channels={channels}
      telegramBox={telegramBox}
    >
      <Content />
    </ContactsSection>
  </div>
</Layout>
