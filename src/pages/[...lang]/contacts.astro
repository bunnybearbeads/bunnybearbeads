---
import Layout from '../../layouts/Layout.astro';
import Accent from '../../components/Accent/Accent.astro';
import { getEntry, render } from 'astro:content';
import { getStaticLangPaths, resolveLang } from '../../utils/i18n';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang: langParam } = Astro.params;
const currentLang = resolveLang(langParam);

const contactsEntry = await getEntry('contacts', currentLang);
if (!contactsEntry) {
  throw new Error(`Contacts entry not found for lang: ${currentLang}`);
}

const { title, subtitle, introHeading, telegramBox, channels, seoTitle, seoDesc } = contactsEntry.data;
const { Content } = await render(contactsEntry);
---

<Layout lang={currentLang} title={seoTitle} description={seoDesc}>
  <div class="container" style="padding-bottom: 80px;">
    <header class="page-header">
      <h1 class="page-title">{title}</h1>
      <p class="page-subtitle">{subtitle}</p>
    </header>

    <div class="contacts-grid">
      <!-- Contact Channels & Info -->
      <div class="contact-channels">
        <div class="content-card" style="margin-bottom: 24px;">
          <h2>{introHeading}</h2>
          <Content />
        </div>

        <a href={channels.telegram.url} target="_blank" rel="noopener noreferrer" class="contact-channel-item channel-telegram-highlight">
          <span class="channel-icon">✈️</span>
          <div class="channel-meta">
            <strong>{channels.telegram.label}</strong>
            <span>{channels.telegram.value}</span>
          </div>
          <span class="channel-badge">Primary</span>
        </a>

        <a href={channels.instagram.url} target="_blank" rel="noopener noreferrer" class="contact-channel-item">
          <span class="channel-icon">📸</span>
          <div class="channel-meta">
            <strong>{channels.instagram.label}</strong>
            <span>{channels.instagram.value}</span>
          </div>
        </a>

        <a href={`mailto:${channels.email.value}`} class="contact-channel-item">
          <span class="channel-icon">✉️</span>
          <div class="channel-meta">
            <strong>{channels.email.label}</strong>
            <span>{channels.email.value}</span>
          </div>
        </a>

        <div class="contact-channel-item">
          <span class="channel-icon">📍</span>
          <div class="channel-meta">
            <strong>{channels.location.label}</strong>
            <span>{channels.location.value}</span>
          </div>
        </div>
      </div>

      <!-- Telegram Direct Box -->
      <div class="telegram-direct-card">
        <div class="telegram-card-header">
          <div class="tg-badge"><span>⚡</span> {telegramBox.badge}</div>
          <h2>{telegramBox.heading}</h2>
          <p>{telegramBox.description}</p>
        </div>

        <div class="tg-perks">
          {telegramBox.perks.map((perk) => (
            <div class="tg-perk-item">
              <span class="tg-perk-icon">{perk.icon}</span>
              <div>
                <strong>{perk.title}</strong>
                <p>{perk.text}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="telegram-card-footer">
          <a href={telegramBox.url} target="_blank" rel="noopener noreferrer" class="btn btn-telegram-large">
            <span>✈️</span> {telegramBox.btnText}
          </a>
          <span class="tg-subtext">Direct dialogue • Instant responses</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .contacts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }

  .contact-channel-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 24px;
    background: var(--card-bg);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    text-decoration: none;
    color: var(--color-brand-dark);
    margin-bottom: 16px;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-soft);
  }

  .contact-channel-item:hover {
    transform: translateY(-2px);
    border-color: var(--accent-gold);
    box-shadow: var(--shadow-medium);
  }

  .channel-telegram-highlight {
    background: linear-gradient(135deg, rgba(42, 123, 136, 0.08) 0%, rgba(212, 163, 89, 0.08) 100%);
    border-color: rgba(42, 123, 136, 0.35) !important;
  }

  .channel-icon {
    font-size: 26px;
    line-height: 1;
  }

  .channel-meta {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .channel-meta strong {
    font-size: 15px;
    color: var(--color-brand-dark);
    margin-bottom: 2px;
  }

  .channel-meta span {
    font-size: 13.5px;
    color: var(--text-muted);
  }

  .channel-badge {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 4px 10px;
    background: var(--accent-teal);
    color: #fff;
    border-radius: 12px;
  }

  .telegram-direct-card {
    background: var(--card-bg);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(42, 123, 136, 0.25);
    border-radius: 20px;
    padding: 40px 36px;
    box-shadow: var(--shadow-medium);
    position: relative;
    overflow: hidden;
  }

  .telegram-direct-card::before {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 140px;
    height: 140px;
    background: radial-gradient(circle, rgba(42, 123, 136, 0.15) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .tg-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(42, 123, 136, 0.1);
    color: var(--accent-teal);
    font-weight: 700;
    font-size: 12px;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 16px;
  }

  .telegram-card-header h2 {
    font-size: 28px;
    margin-bottom: 12px;
    color: var(--color-brand-dark);
  }

  .telegram-card-header p {
    font-size: 15px;
    color: var(--text-dark);
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .tg-perks {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }

  .tg-perk-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .tg-perk-icon {
    font-size: 18px;
    padding-top: 2px;
  }

  .tg-perk-item strong {
    display: block;
    font-size: 14.5px;
    color: var(--color-brand-dark);
  }

  .tg-perk-item p {
    font-size: 13.5px;
    color: var(--text-muted);
    margin: 2px 0 0 0;
    line-height: 1.45;
  }

  .btn-telegram-large {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px 24px;
    background: var(--accent-teal);
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    border-radius: 30px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(42, 123, 136, 0.3);
    transition: all 0.2s ease;
  }

  .btn-telegram-large:hover {
    background: var(--color-brand-accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(42, 123, 136, 0.4);
  }

  .tg-subtext {
    display: block;
    text-align: center;
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 12px;
  }

  @media (max-width: 860px) {
    .contacts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
