---
import './Checkup.css';
import Wysiwyg from '../Wysiwyg/Wysiwyg.astro';
import Button from '../Button/Button.astro';
import Icon from '../Icon/Icon.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import {
  useTranslations,
  formatAuditCalendarDate,
  formatAuditRelativeOnly,
} from '../../i18n/utils';

interface Props {
  loc: any;
  stockLoc?: any;
  product: any;
  currentLang: SupportedLanguage;
}

const { loc, stockLoc, product, currentLang } = Astro.props;
const t = useTranslations(currentLang);
const city = loc.cityKey ? t(loc.cityKey) : '';
const auditDate = stockLoc?.lastCheckedAt || '2026-10-04';
const photoList: string[] = loc.photoUrls?.length
  ? loc.photoUrls
  : loc.photoUrl
    ? [loc.photoUrl, loc.photoUrl]
    : [];
---

<div class="checkup">

  <h3 class="checkup__title" id={`${loc.modalId}-title`}>
    {t('catalog.modal.title')}
  </h3>

  {loc.modalContentKey && (
    <Wysiwyg
      class="checkup__description"
      halved
      set:html={t(loc.modalContentKey).replace('{item}', `<span class="nobr">${product.title}</span>`)}
    />
  )}

  {loc.mapsUrl && loc.modalMapsKey && (
    <div class="checkup__location">
      <Button
        href={loc.mapsUrl}
        target="_blank"
      >
        {t(loc.modalMapsKey)}
        <Icon name="arrow_outward" />
      </Button>
    </div>
  )}

  {photoList.length > 0 && (
    <h4 class="checkup__sub-header">
      <span class="checkup__photo-title">
        {formatAuditCalendarDate(auditDate, currentLang, loc.shop)}
      </span>
      <span class="checkup__date nobr">
        (<span class="nobr" data-audit-relative={auditDate}>{formatAuditRelativeOnly(auditDate, currentLang)}</span>)
      </span>
    </h4>
    <div class="checkup__gallery" data-checkup-photos>
      {photoList.map((url, index) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="checkup__item"
          data-checkup-photo
          data-index={index}
          title={t('catalog.modal.photo_zoom_hint')}
        >
          <img
            src={url}
            alt={`${loc.shop} (${stockLoc?.lastCheckedAt || '2026-10-04'}) — ${index + 1}`}
            class="checkup__image"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
        </a>
      ))}
    </div>
  )}
</div>

<script>
  import PhotoSwipe from 'photoswipe';
  import 'photoswipe/style.css';
  import { getModalBgOpacity } from '../../utils';

  function initCheckupLightbox() {
    if ((window as any).__checkupLightboxInitialized) return;
    (window as any).__checkupLightboxInitialized = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const link = target?.closest<HTMLAnchorElement>('[data-checkup-photo]');
      if (!link) return;

      const container = link.closest<HTMLElement>('[data-checkup-photos]');
      if (!container) return;

      e.preventDefault();

      const photoLinks = Array.from(
        container.querySelectorAll<HTMLAnchorElement>('[data-checkup-photo]')
      );
      const initialIndex = photoLinks.indexOf(link);

      const dataSource = photoLinks.map((item) => {
        const img = item.querySelector<HTMLImageElement>('img');
        const naturalW = img?.naturalWidth || 0;
        const naturalH = img?.naturalHeight || 0;
        return {
          src: item.href || img?.currentSrc || img?.src || '',
          width: naturalW > 0 ? naturalW : 1024,
          height: naturalH > 0 ? naturalH : 768,
          alt: img?.alt || '',
          msrc: img?.src || item.href || '',
          element: img || item,
        };
      });

      const pswp = new PhotoSwipe({
        dataSource,
        index: initialIndex >= 0 ? initialIndex : 0,
        bgOpacity: getModalBgOpacity(),
        wheelToZoom: true,
        closeOnVerticalDrag: true,
        secondaryZoomLevel: (zoomLevel) => Math.max(1, zoomLevel.fit * 2.2),
        maxZoomLevel: (zoomLevel) => Math.max(2.5, zoomLevel.fit * 4),
      });

      // Trap Escape and Tab so parent modal doesn't close or hijack focus
      const onKeyDownCapture = (event: KeyboardEvent) => {
        if (event.key === 'Escape') {
          event.stopImmediatePropagation();
          event.preventDefault();
          pswp.close();
        } else if (event.key === 'Tab') {
          event.stopImmediatePropagation();
        }
      };

      window.addEventListener('keydown', onKeyDownCapture, true);

      pswp.on('destroy', () => {
        window.removeEventListener('keydown', onKeyDownCapture, true);
        link.focus();
      });

      pswp.init();
    });
  }

  initCheckupLightbox();
</script>
