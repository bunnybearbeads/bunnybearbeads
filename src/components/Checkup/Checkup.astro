---
import Availability from '../Availability/Availability.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import {
  useTranslations,
  formatAuditCalendarDate,
  formatAuditRelativeOnly,
} from '../../i18n/utils';

interface Props {
  loc: any;
  stockLoc?: any;
  product: any;
  currentLang: SupportedLanguage;
}

const { loc, stockLoc, product, currentLang } = Astro.props;
const t = useTranslations(currentLang);
const auditDate = stockLoc?.lastCheckedAt || '2026-10-04';
const photoList: string[] = loc.photoUrls?.length
  ? loc.photoUrls
  : loc.photoUrl
    ? [loc.photoUrl, loc.photoUrl]
    : [];

const gallery = photoList.length > 0 ? {
  photos: photoList,
  photoTitle: formatAuditCalendarDate(auditDate, currentLang, loc.shop),
  auditDate,
  relativeDate: formatAuditRelativeOnly(auditDate, currentLang),
  zoomHint: t('catalog.modal.photo_zoom_hint'),
  shopName: loc.shop,
} : undefined;

const action = loc.mapsUrl && loc.modalMapsKey ? {
  href: loc.mapsUrl,
  label: t(loc.modalMapsKey).replace(loc.shop, `<span class="availability__maps-shop">${loc.shop}</span>`),
} : undefined;
---

<Availability
  title={t('catalog.modal.title')}
  titleId={`${loc.modalId}-title`}
  contentHtml={t(loc.modalContentKey).replace('{item}', product.title)}
  action={action}
  gallery={gallery}
/>
