---
import './PageHeader.css';

interface Props {
  title: string;
  subtitle?: string;
  subtitleHtml?: string;
}

const { title, subtitle, subtitleHtml } = Astro.props;
---

<header class="page-header">
  <h1 class="page-title">{title}</h1>
  {subtitleHtml ? (
    <p class="page-subtitle" set:html={subtitleHtml} />
  ) : subtitle ? (
    <p class="page-subtitle">{subtitle}</p>
  ) : null}
</header>
