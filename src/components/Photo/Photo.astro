---
/**
 * Фото из базы — обычный <img> с одним файлом: small (180×240) или large (1080×1440).
 * Обе копии под Retina с сильным сжатием, обычный экран получает тот же файл (scripts/photos.mjs).
 * Ширина и высота — для пропорции, чтобы место было занято до загрузки.
 */
import type { HTMLAttributes } from 'astro/types';
import { photoUrl, type Photo, type PhotoSize } from '../../utils/photos';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'sizes' | 'width' | 'height'> {
  photo: Photo;
  size: PhotoSize;
  alt: string;
}

const { photo, size, alt, ...attrs } = Astro.props;
---

<img {...attrs} src={photoUrl(photo, size)} width={photo.width} height={photo.height} alt={alt} decoding="async" />
