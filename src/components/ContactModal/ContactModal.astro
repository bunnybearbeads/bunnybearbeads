---
/**
 * Небольшая модалка «Напишите мне»: когда я на связи (siteSettings.onlineHours) и кнопки мессенджеров (Inquiry, «Написать в …»).
 * Подключена в Layout — одна на страницу. Открывается ссылками в текстах:
 * <a class="link" href="/ru/contacts" data-hystmodal="#modal-contact" data-modal-always>напишите мне</a>
 * (data-modal-always — модалка и на телефоне, а не переход по href; без JS ссылка ведёт на контакты)
 */
// Стили .link — для ссылок «Напишите мне» в текстах (FAQ, ui.ts), там, где нет компонента Link
import '../Link/Link.css';
import HystModal from '../HystModal/HystModal.astro';
import Window from '../Window/Window.astro';
import Availability from '../Availability/Availability.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { siteSettings } from '../../config/siteSettings';

interface Props {
  currentLang: SupportedLanguage;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);

/** Час разговорно: «10 утра», «8 вечера» / «10 am», «8 pm» / «10 giờ sáng», «8 giờ tối» */
function hour(h: number): string {
  const h12 = h % 12 || 12;
  if (currentLang === 'en') return `${h12} ${h < 12 ? 'am' : 'pm'}`;
  if (currentLang === 'ru') return `${h12}\u00A0${h < 5 ? 'ночи' : h < 12 ? 'утра' : h < 17 ? 'дня' : 'вечера'}`;
  return `${h12} giờ ${h < 11 ? 'sáng' : h < 13 ? 'trưa' : h < 18 ? 'chiều' : 'tối'}`;
}

const { from, to } = siteSettings.onlineHours;
const text = t('contact_modal.text').replace('{from}', hour(from)).replace('{to}', hour(to));
---

<HystModal id="modal-contact" labelledby="modal-contact-title">
  <Window>
    <Availability
      title={t('contact_modal.title')}
      titleId="modal-contact-title"
      contentHtml={text}
      inquiry={{ currentLang, action: 'write', expanded: true }}
    />
  </Window>
</HystModal>
