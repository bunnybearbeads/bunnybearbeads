---
import './AltIcon.css';

interface Props {
  src?: string;
  name?: string;
  outline?: boolean;
  messenger?: string | boolean;
  alt?: string;
  class?: string;
  width?: number | string;
  height?: number | string;
  'aria-hidden'?: 'true' | 'false' | boolean;
  [key: string]: unknown;
}

const {
  src,
  name,
  outline = false,
  messenger,
  alt = '',
  class: className,
  width,
  height,
  'aria-hidden': ariaHidden = 'true',
  ...rest
} = Astro.props;

const isOutline = outline || messenger === 'messenger' || messenger === 'facebook';
const resolvedSrc = src ?? (name ? `/images/messengers/${name}.svg` : undefined);
---

<img
  src={resolvedSrc}
  alt={alt}
  class:list={[
    'alt-icon',
    isOutline && 'alt-icon--outline',
    className,
  ]}
  width={width}
  height={height}
  aria-hidden={ariaHidden}
  loading="lazy"
  {...rest}
/>
