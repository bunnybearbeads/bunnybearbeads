---
/**
 * Шапка товара: хлебные крошки, название, описание, цена, кнопки заказа.
 */
import './ProductHeader.css';
import '../Icon/Icon.css';
import { type SupportedLanguage } from '../../i18n/ui';
import { getLocalizedUrl, useTranslations } from '../../i18n/utils';
import { categoryKey, formatPrice, type CategoryId } from '../../utils/products';
import Inquiry from '../Inquiry/Inquiry.astro';

interface Props {
  product: { title: string; description?: string; price: number };
  categoryId?: CategoryId;
  currentLang: SupportedLanguage;
}

const { product, categoryId = 'bracelets', currentLang } = Astro.props;
const t = useTranslations(currentLang);
const catalogUrl = getLocalizedUrl('/catalog', currentLang);
---

<div class="product-header">
  <nav class="product-header__breadcrumbs" aria-label="Breadcrumb">
    <a href={catalogUrl} class="product-header__breadcrumb">
      {t('catalog.breadcrumb')}
    </a>
    <span class="product-header__breadcrumb-sep" aria-hidden="true">→</span>
    <a
      href={`${catalogUrl}?category=${categoryId}`}
      class="product-header__breadcrumb product-header__breadcrumb--category"
    >
      {t(categoryKey(categoryId))}
    </a>
  </nav>

  <h1 class="product-header__title">{product.title}</h1>

  {product.description && (
    <p class="product-header__description" set:html={product.description} />
  )}

  <div class="product-header__price" set:html={formatPrice(product.price)} />

  <div class="product-header__actions">
    <Inquiry
      currentLang={currentLang}
      productTitle={product.title}
    />
  </div>
</div>
