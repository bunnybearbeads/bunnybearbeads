---
/**
 * «Полезно знать» под галереей: 2–4 ссылки на подробности — модалки или страницы (FAQ).
 * Ссылка с modal открывает модалку по id, с href — ведёт на страницу. note — строкой под списком, текстом
 */
import './ProductGuides.css';
import Link from '../Link/Link.astro';

export interface ProductGuide {
  label: string;
  /** id модалки без # — откроется по клику */
  modal?: string;
  /** Адрес страницы, если это не модалка */
  href?: string;
}

interface Props {
  heading: string;
  guides: ProductGuide[];
  /** Строка под списком — текст, не ссылка (HTML) */
  note?: string;
  class?: string;
}

const { heading, guides, note, class: className } = Astro.props;
---

{guides.length > 0 && (
  <div class:list={['product-guides', className]}>
    <strong class="product-guides__heading">
      {heading}
    </strong>
    <div class="product-guides__box">
      <ul class="product-guides__list">
        {guides.map((guide) => (
          <li class="product-guides__item">
            {guide.modal ? (
              <Link as="button" class="product-guides__link" data-hystmodal={`#${guide.modal}`}>
                {guide.label}
              </Link>
            ) : (
              <Link href={guide.href} class="product-guides__link">
                {guide.label}
              </Link>
            )}
          </li>
        ))}
      </ul>
      {note && <p class="product-guides__note" set:html={note} />}
    </div>
  </div>
)}
