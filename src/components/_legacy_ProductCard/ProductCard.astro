---
import './ProductCard.css';
import { type SupportedLanguage } from '../../i18n/ui';
import { getLocalizedUrl, useTranslations } from '../../i18n/utils';
import { formatPrice } from '../../utils/products';
import { CATEGORY_SECTION, categoryKey, type Category } from '../../config/categories';

interface ProductCardData {
  title: string;
  description?: string;
  price: number;
}

interface Props {
  id: string;
  category: Category;
  /** Точки, где товар есть в наличии. По ним фильтрует каталог */
  locations: string[];
  /** Первое изображение (для видео — постер) */
  image?: string;
  data: ProductCardData;
  currentLang: SupportedLanguage;
}

const { id, category, locations, image, data, currentLang } = Astro.props;
const t = useTranslations(currentLang);
const detailUrl = getLocalizedUrl(`/catalog/${id}`, currentLang);

const categoryIcons: Record<Category, string> = {
  charm: '📱',
  bracelet: '📿',
  ring: '💍',
  earrings: '✨',
  'pen-wrap': '🖊️',
};
const placeholderIcon = categoryIcons[category];
---

<article class="product-card" data-category={CATEGORY_SECTION[category]} data-locations={locations.join(' ')}>
  {image ? (
    <div class="product-image-box">
      <img
        src={image}
        alt={data.title}
        loading="lazy"
      />
    </div>
  ) : (
    <div class="product-image-box product-placeholder-box">
      <span class="placeholder-icon">{placeholderIcon}</span>
    </div>
  )}

  <div class="product-details">
    <span class="product-category">{t(categoryKey(category))}</span>
    <h2 class="product-title">
      <a href={detailUrl}>
        {data.title}
      </a>
    </h2>
    {/* В описании бывают строчные теги — в анонсе карточки только текст */}
    <p class="product-desc">{(data.description ?? '').replace(/<[^>]+>/g, '')}</p>

    <div class="product-bottom">
      <span class="product-price" set:html={formatPrice(data.price)} />
      <a href={detailUrl} class="btn btn-primary btn-sm">
        {t('catalog.view_details')} →
      </a>
    </div>
  </div>
</article>
