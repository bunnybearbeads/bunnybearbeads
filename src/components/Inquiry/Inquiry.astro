---
import './Inquiry.css';
import Button from '../Button/Button.astro';
import AltIcon from '../AltIcon/AltIcon.astro';
import QrModal from '../QrModal/QrModal.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { siteSettings } from '../../config/siteSettings';

export interface Props {
  currentLang: SupportedLanguage;
  productTitle?: string;
  class?: string;
  withModals?: boolean;
}

const {
  currentLang,
  productTitle,
  class: className,
  withModals = true,
} = Astro.props;

const t = useTranslations(currentLang);

type MessengerKey = 'messenger' | 'telegram' | 'zalo';

const priorityByLang: Record<SupportedLanguage, MessengerKey> = {
  en: 'messenger',
  ru: 'telegram',
  vi: 'zalo',
};

const highlightedKey = priorityByLang[currentLang] ?? 'telegram';

interface MessengerItem {
  id: MessengerKey;
  name: string;
  modalId: string;
  url: string;
  icon: string;
  qrImage: string;
  username: string;
  isHighlighted: boolean;
}

const messengersData: MessengerItem[] = [
  {
    id: 'telegram',
    name: 'Telegram',
    modalId: 'qr-modal-telegram',
    url: siteSettings.contacts.telegramUrl,
    icon: '/images/messengers/telegram.svg',
    qrImage: '/images/qr/telegram.svg',
    username: siteSettings.contacts.telegramHandle || 'bunnybearbeads',
    isHighlighted: highlightedKey === 'telegram',
  },
  {
    id: 'messenger',
    name: 'Messenger',
    modalId: 'qr-modal-messenger',
    url: siteSettings.contacts.messengerUrl,
    icon: '/images/messengers/messenger.svg',
    qrImage: '/images/qr/messenger.svg',
    username: siteSettings.contacts.messengerHandle || 'bunnybearbeads',
    isHighlighted: highlightedKey === 'messenger',
  },
  {
    id: 'zalo',
    name: 'Zalo',
    modalId: 'qr-modal-zalo',
    url: siteSettings.contacts.zaloUrl,
    icon: '/images/messengers/zalo.svg',
    qrImage: '/images/qr/zalo.svg',
    username: siteSettings.contacts.zaloHandle || 'bunnybearbeads',
    isHighlighted: highlightedKey === 'zalo',
  },
];

const orderedMessengers = [...messengersData].sort((a, b) => {
  if (a.isHighlighted) return -1;
  if (b.isHighlighted) return 1;
  return 0;
});
---

<div class:list={['inquiry', className]} role="group" aria-label={t('catalog.order_piece')}>
  {orderedMessengers.map((item) => {
    const fullLabel = `${t('catalog.inquiry.order_via')} ${item.name}`;
    return (
      <Button
        data-hystmodal={`#${item.modalId}`}
        square={!item.isHighlighted}
        aria-label={!item.isHighlighted ? fullLabel : undefined}
        title={fullLabel}
      >
        <AltIcon
          src={item.icon}
          outline={item.id === 'messenger'}
          alt=""
        />
        {item.isHighlighted && (
          <span class="inquiry__label">
            {t('catalog.inquiry.order')}<span class="inquiry__channel"> {t('catalog.inquiry.via')} {item.name}</span>
          </span>
        )}
      </Button>
    );
  })}
</div>

{withModals && messengersData.map((item) => (
  <QrModal
    id={item.modalId}
    messenger={item.id}
    name={item.name}
    qrImage={item.qrImage}
    username={item.username}
    link={item.url}
  />
))}
