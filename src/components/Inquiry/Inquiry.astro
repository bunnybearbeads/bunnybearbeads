---
import './Inquiry.css';
import Button from '../Button/Button.astro';
import AltIcon from '../AltIcon/AltIcon.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { siteSettings } from '../../config/siteSettings';

export interface Props {
  currentLang: SupportedLanguage;
  productTitle?: string;
  class?: string;
}

const {
  currentLang,
  productTitle,
  class: className,
} = Astro.props;

const t = useTranslations(currentLang);

type MessengerKey = 'whatsapp' | 'telegram' | 'zalo';

const priorityByLang: Record<SupportedLanguage, MessengerKey> = {
  en: 'whatsapp',
  ru: 'telegram',
  vi: 'zalo',
};

const highlightedKey = priorityByLang[currentLang] ?? 'telegram';

interface MessengerItem {
  id: MessengerKey;
  name: string;
  url: string;
  icon: string;
  isHighlighted: boolean;
}

const messengersData: MessengerItem[] = [
  {
    id: 'telegram',
    name: 'Telegram',
    url: siteSettings.contacts.telegramUrl,
    icon: '/images/messengers/telegram.svg',
    isHighlighted: highlightedKey === 'telegram',
  },
  {
    id: 'whatsapp',
    name: 'WhatsApp',
    url: siteSettings.contacts.whatsappUrl,
    icon: '/images/messengers/whatsapp.svg',
    isHighlighted: highlightedKey === 'whatsapp',
  },
  {
    id: 'zalo',
    name: 'Zalo',
    url: siteSettings.contacts.zaloUrl,
    icon: '/images/messengers/zalo.svg',
    isHighlighted: highlightedKey === 'zalo',
  },
];

const orderedMessengers = [...messengersData].sort((a, b) => {
  if (a.isHighlighted) return -1;
  if (b.isHighlighted) return 1;
  return 0;
});
---

<div class:list={['inquiry', className]} role="group" aria-label={t('catalog.order_piece')}>
  {orderedMessengers.map((item) => {
    const fullLabel = `${t('catalog.inquiry.order_via')} ${item.name}`;
    return (
      <Button
        href={item.url}
        target="_blank"
        square={!item.isHighlighted}
        aria-label={!item.isHighlighted ? fullLabel : undefined}
        title={fullLabel}
      >
        <AltIcon
          src={item.icon}
          alt=""
        />
        {item.isHighlighted && (
          <span class="inquiry__label">
            {t('catalog.inquiry.order')}<span class="inquiry__channel"> {t('catalog.inquiry.via')} {item.name}</span>
          </span>
        )}
      </Button>
    );
  })}
</div>
