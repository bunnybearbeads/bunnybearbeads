---
import './Inquiry.css';
import Button from '../Button/Button.astro';
import AltIcon from '../AltIcon/AltIcon.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { messengers, type MessengerKey } from './messengers';

export interface Props {
  currentLang: SupportedLanguage;
  productTitle?: string;
  /** Подписи кнопок: «Заказать в …» (по умолчанию) или «Написать в …» — в модалке связи */
  action?: 'order' | 'write';
  /** Для модалок: все кнопки раскрыты — первая с подписью «Написать в …», остальные — «В Messenger» */
  expanded?: boolean;
  class?: string;
}

const {
  currentLang,
  productTitle,
  action = 'order',
  expanded = false,
  class: className,
} = Astro.props;

const t = useTranslations(currentLang);

const priorityByLang: Record<SupportedLanguage, MessengerKey> = {
  en: 'messenger',
  ru: 'telegram',
  vi: 'zalo',
};

/** «В Messenger», «Via Messenger», «Qua Zalo» — подпись остальных кнопок в раскрытом виде */
const via = t('catalog.inquiry.via');
const viaLabel = via.charAt(0).toUpperCase() + via.slice(1);

const highlightedKey = priorityByLang[currentLang] ?? 'telegram';

const messengersData = messengers.map((item) => ({
  ...item,
  isHighlighted: item.id === highlightedKey,
}));

const orderedMessengers = [...messengersData].sort((a, b) => {
  if (a.isHighlighted) return -1;
  if (b.isHighlighted) return 1;
  return 0;
});
---

{/* На мобильном кнопка ведёт сразу в мессенджер, на десктопе открывает QR-модалку (InquiryModals, utils/modals.ts).
    data-stacked — QR открывается поверх модалки, из которой нажали (связь, повтор): Esc и крестик возвращают в неё */}
<div class:list={['inquiry', { 'inquiry--expanded': expanded }, className]} role="group" aria-label={t('catalog.order_piece')}>
  {orderedMessengers.map((item) => {
    const fullLabel = `${t(action === 'write' ? 'catalog.inquiry.write_via' : 'catalog.inquiry.order_via')} ${item.name}`;
    return (
      <Button
        href={item.url}
        data-hystmodal={`#${item.modalId}`}
        data-stacked
        data-zalo={item.zaloCode}
        square={!expanded && !item.isHighlighted}
        aria-label={!item.isHighlighted ? fullLabel : undefined}
        title={fullLabel}
      >
        <AltIcon
          src={item.icon}
          alt=""
        />
        {expanded && !item.isHighlighted ? (
          <span class="inquiry__label">{viaLabel} {item.name}</span>
        ) : item.isHighlighted && (
          <span class="inquiry__label">
            {t(action === 'write' ? 'catalog.inquiry.write' : 'catalog.inquiry.order')}<span class="inquiry__channel"> {t('catalog.inquiry.via')} {item.name}</span>
          </span>
        )}
      </Button>
    );
  })}
</div>
