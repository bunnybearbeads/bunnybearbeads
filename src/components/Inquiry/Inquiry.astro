---
import './Inquiry.css';
import Button from '../Button/Button.astro';
import AltIcon from '../AltIcon/AltIcon.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { messengers, type MessengerKey } from './messengers';

export interface Props {
  currentLang: SupportedLanguage;
  productTitle?: string;
  class?: string;
}

const {
  currentLang,
  productTitle,
  class: className,
} = Astro.props;

const t = useTranslations(currentLang);

const priorityByLang: Record<SupportedLanguage, MessengerKey> = {
  en: 'messenger',
  ru: 'telegram',
  vi: 'zalo',
};

const highlightedKey = priorityByLang[currentLang] ?? 'telegram';

const messengersData = messengers.map((item) => ({
  ...item,
  isHighlighted: item.id === highlightedKey,
}));

const orderedMessengers = [...messengersData].sort((a, b) => {
  if (a.isHighlighted) return -1;
  if (b.isHighlighted) return 1;
  return 0;
});
---

{/* На мобильном кнопка ведёт сразу в мессенджер, на десктопе открывает QR-модалку (InquiryModals, utils/modals.ts) */}
<div class:list={['inquiry', className]} role="group" aria-label={t('catalog.order_piece')}>
  {orderedMessengers.map((item) => {
    const fullLabel = `${t('catalog.inquiry.order_via')} ${item.name}`;
    return (
      <Button
        href={item.url}
        data-hystmodal={`#${item.modalId}`}
        square={!item.isHighlighted}
        aria-label={!item.isHighlighted ? fullLabel : undefined}
        title={fullLabel}
      >
        <AltIcon
          src={item.icon}
          alt=""
        />
        {item.isHighlighted && (
          <span class="inquiry__label">
            {t('catalog.inquiry.order')}<span class="inquiry__channel"> {t('catalog.inquiry.via')} {item.name}</span>
          </span>
        )}
      </Button>
    );
  })}
</div>
