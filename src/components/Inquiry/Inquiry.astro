---
import './Inquiry.css';
import Button from '../Button/Button.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { siteSettings } from '../../config/siteSettings';

export interface Props {
  currentLang: SupportedLanguage;
  productTitle?: string;
  size?: 'smaller' | 'larger';
  class?: string;
}

const {
  currentLang,
  productTitle,
  size,
  class: className,
} = Astro.props;

const t = useTranslations(currentLang);

type MessengerKey = 'whatsapp' | 'telegram' | 'zalo';

const priorityByLang: Record<SupportedLanguage, MessengerKey> = {
  en: 'whatsapp',
  ru: 'telegram',
  vi: 'zalo',
};

const highlightedKey = priorityByLang[currentLang] ?? 'telegram';

interface MessengerItem {
  id: MessengerKey;
  name: string;
  url: string;
  isHighlighted: boolean;
}

const messengersData: MessengerItem[] = [
  {
    id: 'telegram',
    name: 'Telegram',
    url: siteSettings.contacts.telegramUrl,
    isHighlighted: highlightedKey === 'telegram',
  },
  {
    id: 'whatsapp',
    name: 'WhatsApp',
    url: siteSettings.contacts.whatsappUrl,
    isHighlighted: highlightedKey === 'whatsapp',
  },
  {
    id: 'zalo',
    name: 'Zalo',
    url: siteSettings.contacts.zaloUrl,
    isHighlighted: highlightedKey === 'zalo',
  },
];

const orderedMessengers = [...messengersData].sort((a, b) => {
  if (a.isHighlighted) return -1;
  if (b.isHighlighted) return 1;
  return 0;
});
---

<div class:list={['inquiry', className]} role="group" aria-label={t('catalog.order_piece')}>
  {orderedMessengers.map((item) => (
    <Button
      href={item.url}
      target="_blank"
      size={size}
      square={!item.isHighlighted}
      aria-label={!item.isHighlighted ? item.name : undefined}
      title={item.name}
    >
      {item.id === 'whatsapp' && (
        <svg class="icon" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.49 0 .16 5.33.158 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.558 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
      )}

      {item.id === 'telegram' && (
        <svg class="icon" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" fill="currentColor">
          <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
        </svg>
      )}

      {item.id === 'zalo' && (
        <svg class="icon" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" fill="currentColor">
          <path d="M12.49 10.2722v-.4496h1.3467v6.3218h-.7704a.576.576 0 01-.5763-.5729l-.0006.0005a3.273 3.273 0 01-1.9372.6321c-1.8138 0-3.2844-1.4697-3.2844-3.2823 0-1.8125 1.4706-3.2822 3.2844-3.2822a3.273 3.273 0 011.9372.6321l.0006.0005zM6.9188 7.7896v.205c0 .3823-.051.6944-.2995 1.0605l-.03.0343c-.0542.0615-.1815.206-.2421.2843L2.024 14.8h4.8948v.7682a.5764.5764 0 01-.5767.5761H0v-.3622c0-.4436.1102-.6414.2495-.8476L4.8582 9.23H.1922V7.7896h6.7266zm8.5513 8.3548a.4805.4805 0 01-.4803-.4798v-7.875h1.4416v8.3548H15.47zM20.6934 9.6C22.52 9.6 24 11.0807 24 12.9044c0 1.8252-1.4801 3.306-3.3066 3.306-1.8264 0-3.3066-1.4808-3.3066-3.306 0-1.8237 1.4802-3.3044 3.3066-3.3044zm-10.1412 5.253c1.0675 0 1.9324-.8645 1.9324-1.9312 0-1.065-.865-1.9295-1.9324-1.9295s-1.9324.8644-1.9324 1.9295c0 1.0667.865 1.9312 1.9324 1.9312zm10.1412-.0033c1.0737 0 1.945-.8707 1.945-1.9453 0-1.073-.8713-1.9436-1.945-1.9436-1.0753 0-1.945.8706-1.945 1.9436 0 1.0746.8697 1.9453 1.945 1.9453z"/>
        </svg>
      )}

      {item.isHighlighted && item.name}
    </Button>
  ))}
</div>
