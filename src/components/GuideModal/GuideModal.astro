---
/**
 * Модалка со статичным текстом из секции «Полезно знать» (ProductGuides): заголовок и HTML.
 * Оформление — как у остальных модалок товара: Window + Availability
 */
import HystModal from '../HystModal/HystModal.astro';
import Window from '../Window/Window.astro';
import Availability from '../Availability/Availability.astro';

interface Props {
  /** id модалки — на него ссылается data-hystmodal */
  id: string;
  title: string;
  contentHtml: string;
}

const { id, title, contentHtml } = Astro.props;
---

<HystModal id={id} labelledby={`${id}-title`}>
  <Window>
    <Availability
      title={title}
      titleId={`${id}-title`}
      contentHtml={contentHtml}
    />
  </Window>
</HystModal>
