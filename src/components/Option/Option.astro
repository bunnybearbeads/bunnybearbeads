---
import './Option.css';

interface Props {
  icon: string;
  class?: string;
  clickable?: boolean;
  modalTarget?: string;
  auditHint?: string;
}

const {
  icon,
  class: className,
  clickable = false,
  modalTarget,
  auditHint,
  ...rest
} = Astro.props;
---

<div class:list={['option', className]} {...rest}>
  <div class="option__icon">
    {icon}
  </div>
  <div class="option__title">
    <slot name="title" />
  </div>
  {Astro.slots.has('subnote') && (
    <div class="option__notes">
      <slot name="subnote" />
    </div>
  )}
  {Astro.slots.has('quantity') && (
    <div
      class:list={[
        'option__quantity',
        clickable && 'option__quantity--clickable',
      ]}
      data-hystmodal={modalTarget}
      role={clickable ? 'button' : undefined}
      title={auditHint}
    >
      <slot name="quantity" />
    </div>
  )}
  <slot />
</div>
