---
import './Product.css';
import '../Wysiwyg/Wysiwyg.css';
import Gallery from '../Gallery/Gallery.astro';
import Family from '../Family/Family.astro';
import ProductHeader from '../ProductHeader/ProductHeader.astro';
import ProductAvailability from '../_legacy_ProductDetail/ProductAvailability.astro';
import PartnerModals from '../_legacy_ProductDetail/PartnerModals.astro';
import RemakeModal from '../RemakeModal/RemakeModal.astro';
import BraceletClasps from '../BraceletClasps/BraceletClasps.astro';
import DottedTitle from '../DottedTitle/DottedTitle.astro';
import { type SupportedLanguage, type TranslationKey } from '../../i18n/ui';
import { useTranslations, localize } from '../../i18n/utils';
import { siteSettings } from '../../config/siteSettings';
import { type ProductEntry, getFamilyOf, getLocationQty } from '../../utils/products';
import { materialsHtml } from '../../utils/materials';
import { sizeSection, sizeFit } from '../../utils/size';

interface Props {
  entry: ProductEntry;
  currentLang: SupportedLanguage;
}

const { entry, currentLang } = Astro.props;
const t = useTranslations(currentLang);
const raw = entry.data;
const product = localize(raw, currentLang);
const family = await getFamilyOf(entry.id);
const studioQty = getLocationQty(raw.stock, 'atelier');
const canRemake = studioQty === 0;
const size = sizeSection(raw.size, t, currentLang);
const materials = raw.materials ? materialsHtml(raw.materials, t, raw.credits.designer) : '';

/** Текстовые разделы аккордеона: прочность и уход, предостережения (свой текст у категории). Крепление брелка — первым разделом, см. разметку */
const isCharm = raw.category === 'charm';
const textSections = [
  { heading: t('catalog.care.title'), html: t(`catalog.care.${raw.category}` as TranslationKey) },
  { heading: t('catalog.warnings.title'), html: t(`catalog.warnings.${raw.category}` as TranslationKey).replaceAll('{age}', String(siteSettings.ageLimit)) },
];

const BRAND = 'bunnybearbeads';
/** Подписи известных ролей переведены; любая другая роль выводится как записана в базе, с заглавной */
const CREDIT_LABELS: Record<string, Parameters<typeof t>[0]> = {
  designer: 'catalog.designed_by',
  crafter: 'catalog.crafted_by',
  photographer: 'catalog.photo_by',
};
// Сначала кто сплёл, потом автор схемы, остальные роли — как в базе
const { crafter, designer, ...otherCredits } = raw.credits;
const creditRows = Object.entries({ crafter, designer, ...otherCredits }).map(([role, name]) => ({
  label: CREDIT_LABELS[role] ? t(CREDIT_LABELS[role]) : role.charAt(0).toUpperCase() + role.slice(1),
  name,
}));
const showCredits = creditRows.some(({ name }) => name !== BRAND);
---

<div class="product">
  <div class="product__wrap container">
    <div class="product__body">
      <div class="product__summary">
        <div class="product__gallery">
          <Gallery images={raw.gallery} alt={product.title} lang={currentLang} />
        </div>

        {family && (
          <div class="product__family">
            <Family family={family} currentId={entry.id} currentLang={currentLang} />
          </div>
        )}

        <div class="product__specs">
          <DottedTitle>{t('catalog.good_to_know')}</DottedTitle>

          <div class="product__specs-box">
            <!-- Разделы — аккордеон на details, по умолчанию все свёрнуты. Первым — крепление: у браслета застёжка, у брелка сменное крепление -->
            {isCharm && (
              <details class="product-specs-section">
                <summary class="specs-heading">
                  {t('catalog.charm_attachment.title')}
                </summary>
                <div class="specs-text wysiwyg wysiwyg--smaller wysiwyg--smaller-list-items-margin" set:html={t('catalog.charm_attachment.text')} />
              </details>
            )}

            {raw.category === 'bracelet' && (
              <details class="product-specs-section">
                <summary class="specs-heading">
                  {t('catalog.clasps.title')}
                </summary>
                <BraceletClasps currentLang={currentLang} parts={raw.materials?.findings?.bracelet?.map(({ part }) => part)} />
              </details>
            )}

            {size.html && (
              <details class="product-specs-section">
                <summary class="specs-heading">
                  {size.heading}
                </summary>
                <div class="size-box wysiwyg wysiwyg--smaller wysiwyg--smaller-list-items-margin" set:html={size.html} />
              </details>
            )}

            <!-- Materials Section -->
            {materials && (
              <details class="product-specs-section">
                <summary class="specs-heading">
                  {t('catalog.materials_label')}
                </summary>
                <div class="materials-html-content wysiwyg wysiwyg--smaller wysiwyg--smaller-list-items-margin" set:html={materials} />
              </details>
            )}

            {textSections.map(({ heading, html }) => (
              <details class="product-specs-section">
                <summary class="specs-heading">
                  {heading}
                </summary>
                <div class="specs-text wysiwyg wysiwyg--smaller wysiwyg--smaller-list-items-margin" set:html={html} />
              </details>
            ))}

            <!-- Credits Section: всё своё (все имена — bunnybearbeads) — секции нет -->
            {showCredits && (
              <details class="product-specs-section credits-section">
                <summary class="specs-heading">
                  {t('catalog.credits')}
                </summary>
                <div class="credits-box wysiwyg wysiwyg--smaller wysiwyg--smaller-list-items-margin">
                  <ul>
                    {creditRows.map(({ label, name }) => (
                      <li>{label}: <strong>{name}</strong></li>
                    ))}
                  </ul>
                </div>
              </details>
            )}
          </div>
        </div>
      </div>

      <div class="product__details">
        <ProductHeader
          product={product}
          category={raw.category}
          fit={sizeFit(raw.size, t, currentLang)}
          currentLang={currentLang}
        />

        <div class="product__availability">
          <ProductAvailability
            stock={raw.stock}
            remake={raw.remake}
            title={product.title}
            currentLang={currentLang}
          />
        </div>
      </div>
    </div>

    <div class="product__related">

    </div>
  </div>
</div>

<PartnerModals product={product} currentLang={currentLang} />

{canRemake && (
  <RemakeModal
    product={product}
    currentLang={currentLang}
    remakeDays={siteSettings.fulfillment.remakeDays}
  />
)}
