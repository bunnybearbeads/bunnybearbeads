---
import './Product.css';
import Gallery from '../Gallery/Gallery.astro';
import Family from '../Family/Family.astro';
import GuideModal from '../GuideModal/GuideModal.astro';
import ProductGuides from '../ProductGuides/ProductGuides.astro';
import ProductHeader from '../ProductHeader/ProductHeader.astro';
import ProductAvailability from '../_legacy_ProductDetail/ProductAvailability.astro';
import PartnerModals from '../_legacy_ProductDetail/PartnerModals.astro';
import RemakeModal from '../RemakeModal/RemakeModal.astro';
import InquiryModals from '../Inquiry/InquiryModals.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { getLocalizedUrl, useTranslations, localize } from '../../i18n/utils';
import { siteSettings } from '../../config/siteSettings';
import { type ProductEntry, getFamilyOf, getLocationQty } from '../../utils/products';

interface Props {
  entry: ProductEntry;
  currentLang: SupportedLanguage;
}

const { entry, currentLang } = Astro.props;
const t = useTranslations(currentLang);
const raw = entry.data;
const product = localize(raw, currentLang);
const family = await getFamilyOf(entry.id);
const studioQty = getLocationQty(raw.stock, 'atelier');
const canRemake = studioQty === 0;

/**
 * «Полезно знать» под галереей: 2–4 ссылки. С html — модалка с этим текстом (заголовок = подпись ссылки),
 * с href — ссылка на страницу (например, FAQ)
 */
interface Guide { label: string; modal?: string; html?: string; href?: string }
const isCharm = raw.category === 'charm';
const guides: Guide[] = [
  ...(isCharm ? [
    { modal: 'modal-charm-attachment', label: t('catalog.charm_attachment.title'), html: t('catalog.charm_attachment.text') },
    { modal: 'modal-charm-durability', label: t('catalog.charm_durability.title'), html: t('catalog.charm_durability.text') },
  ] : []),
  { label: t('catalog.faq_link'), href: getLocalizedUrl('/faq', currentLang) },
];

const BRAND = 'bunnybearbeads';
/** Подписи известных ролей переведены; любая другая роль выводится как записана в базе, с заглавной */
const CREDIT_LABELS: Record<string, Parameters<typeof t>[0]> = {
  design: 'catalog.designed_by',
  craft: 'catalog.crafted_by',
  photo: 'catalog.photo_by',
};
// Сначала кто сплёл, потом автор схемы, остальные роли — как в базе
const { craft, design, ...otherCredits } = raw.credits;
const creditRows = Object.entries({ craft, design, ...otherCredits }).map(([role, name]) => ({
  label: CREDIT_LABELS[role] ? t(CREDIT_LABELS[role]) : role.charAt(0).toUpperCase() + role.slice(1),
  name,
}));
const showCredits = creditRows.some(({ name }) => name !== BRAND);
---

<div class="product">
  <div class="product__wrap container">
    <div class="product__body">
      <div class="product__summary">
        <div class="product__gallery">
          <Gallery images={raw.gallery} alt={product.title} lang={currentLang} />
        </div>

        {family && (
          <div class="product__family">
            <Family family={family} currentId={entry.id} currentLang={currentLang} />
          </div>
        )}

        <div class="product__specs">
          <ProductGuides class="product-specs-section" heading={t('catalog.good_to_know')} guides={guides} note={t('catalog.age_limit')} />

          <!-- Materials Section -->
          {raw.materials && (
            <div class="product-specs-section">
              <strong class="specs-heading">
                {t('catalog.materials_label')}
              </strong>
              <div class="materials-html-content" set:html={raw.materials} />
            </div>
          )}

          <!-- Credits Section: всё своё (все имена — bunnybearbeads) — секции нет -->
          {showCredits && (
            <div class="product-specs-section credits-section">
              <strong class="specs-heading">
                {t('catalog.credits')}
              </strong>
              <div class="credits-box">
                {creditRows.map(({ label, name }) => (
                  <div class="credit-row">
                    <span class="credit-label">{label}:</span>
                    <span class:list={['credit-val', { 'brand-craft': name === BRAND }]}>{name}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>

      <div class="product__details">
        <ProductHeader
          product={product}
          category={raw.category}
          currentLang={currentLang}
        />

        <div class="product__availability">
          <ProductAvailability
            stock={raw.stock}
            remake={raw.remake}
            title={product.title}
            currentLang={currentLang}
          />
        </div>
      </div>
    </div>

    <div class="product__related">

    </div>
  </div>
</div>

<InquiryModals currentLang={currentLang} />
<PartnerModals product={product} currentLang={currentLang} />

{guides.map((guide) => guide.modal && guide.html && (
  <GuideModal id={guide.modal} title={guide.label} contentHtml={guide.html} />
))}

{canRemake && (
  <RemakeModal
    product={product}
    currentLang={currentLang}
    remakeDays={siteSettings.fulfillment.remakeDays}
  />
)}
