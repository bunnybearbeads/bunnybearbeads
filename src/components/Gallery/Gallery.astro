---
import './Gallery.css';
import './GalleryArrows.css';
import 'photoswipe/style.css';
import Icon from '../Icon/Icon.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  images: (string | { type?: 'image' | 'video'; src: string; poster?: string })[];
  alt: string;
  lang?: SupportedLanguage;
}

const { images = [], alt, lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface MediaItem {
  type: 'image' | 'video';
  src: string;
  poster?: string;
}

const items: MediaItem[] = images.map((item) => {
  if (typeof item === 'string') {
    const isVideo = /\.(mp4|webm|ogg|mov)$/i.test(item);
    return {
      type: isVideo ? 'video' : 'image',
      src: item,
      poster: isVideo ? item.replace(/\.[^.]+$/, '.jpg') : undefined,
    };
  }
  const isVideo = item.type === 'video' || /\.(mp4|webm|ogg|mov)$/i.test(item.src);
  return {
    type: isVideo ? 'video' : 'image',
    src: item.src,
    poster: item.poster || (isVideo ? item.src.replace(/\.[^.]+$/, '.jpg') : undefined),
  };
});
---

<div class="gallery" data-gallery>
  <div class="gallery__navigation" data-gallery-thumbs-col>
    <button
      class="gallery__control gallery__control--prev"
      data-gallery-thumbs-prev
      aria-label={t('gallery.thumbs_prev')}
      tabindex="-1"
      type="button"
      hidden
    >
      <Icon name="keyboard_arrow_up" />
    </button>

    <div class="gallery__nav-viewport" data-gallery-thumbs>
      <div class="gallery__nav-ribbon" aria-label={t('gallery.thumbs_ribbon')}>
        {items.map((item, index) => {
          const thumbSrc = item.type === 'video' ? (item.poster || item.src) : item.src;
          const mediaLabel = item.type === 'video' ? t('gallery.video') : t('gallery.photo');
          return (
            <button
              class:list={[
                'gallery__thumbnail',
                { 'gallery__thumbnail--current': index === 0 },
                { 'gallery__thumbnail--video': item.type === 'video' },
              ]}
              data-gallery-thumb-slide
              aria-label={`${alt} — ${mediaLabel} ${index + 1}`}
              aria-current={index === 0 ? 'true' : undefined}
              tabindex="-1"
              type="button"
            >
              <img
                class="gallery__thumb-image"
                src={thumbSrc}
                alt={`${alt} — ${t('gallery.preview')} ${index + 1}`}
                loading={index >= 5 ? 'lazy' : undefined}
              />
              {item.type === 'video' && (
                <span class="gallery__thumb-play" aria-hidden="true">
                  <Icon name="play_arrow" />
                </span>
              )}
            </button>
          );
        })}
      </div>
    </div>

    <button
      class="gallery__control gallery__control--next"
      data-gallery-thumbs-next
      aria-label={t('gallery.thumbs_next')}
      tabindex="-1"
      type="button"
      hidden
    >
      <Icon name="keyboard_arrow_down" />
    </button>
  </div>

  <div class="gallery__stage" data-gallery-stage-col>
    <button
      class="gallery__control gallery__control--stage gallery__control--prev"
      data-gallery-main-prev
      aria-label={t('gallery.main_prev')}
      type="button"
      hidden
    >
      <Icon name="keyboard_arrow_up" />
    </button>

    <div class="gallery__viewport">
      <div class="gallery__strut" data-gallery-main>
        <div class="gallery__ribbon">
          {items.map((item, index) => (
            <div class="gallery__item">
              {item.type === 'video' ? (
                <video
                  class="gallery__image gallery__image--video"
                  src={item.src}
                  poster={item.poster}
                  autoplay
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  data-gallery-video
                />
                <button
                  class="gallery__full-screen-handler"
                  data-gallery-video-fs
                  aria-label={t('gallery.fullscreen')}
                  type="button"
                >
                  <Icon name="open_in_full" />
                </button>
              ) : (
                <img
                  class="gallery__image"
                  src={item.src}
                  alt={index === 0 ? alt : `${alt} — ${t('gallery.photo')} ${index + 1}`}
                  fetchpriority={index === 0 ? 'high' : 'low'}
                  loading={index === 0 ? undefined : 'lazy'}
                />
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    <button
      class="gallery__control gallery__control--stage gallery__control--next"
      data-gallery-main-next
      aria-label={t('gallery.main_next')}
      type="button"
      hidden
    >
      <Icon name="keyboard_arrow_down" />
    </button>
  </div>
</div>

<script>
  /* AI (whole script) */
  import EmblaCarousel from 'embla-carousel';
  import PhotoSwipe from 'photoswipe';
  import {
    isMobile,
    BREAKPOINTS,
    setAttrIfChanged,
    setHiddenIfChanged,
    isEditableTarget,
  } from '../../utils';

  const THUMBS_SCROLL_STEP = 4;
  const galleries = document.querySelectorAll<HTMLElement>('[data-gallery]');

  galleries.forEach((galleryRoot) => {
    const mainNode = galleryRoot.querySelector<HTMLElement>('[data-gallery-main]');
    const thumbsNode = galleryRoot.querySelector<HTMLElement>('[data-gallery-thumbs]');
    const mainPrevBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-main-prev]');
    const mainNextBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-main-next]');
    const prevBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-thumbs-prev]');
    const nextBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-thumbs-next]');
    const videos = Array.from(
      galleryRoot.querySelectorAll<HTMLVideoElement>('[data-gallery-video]')
    );
    const thumbSlides = Array.from(
      galleryRoot.querySelectorAll<HTMLElement>('[data-gallery-thumb-slide]')
    );

    if (!mainNode || !thumbsNode) return;

    // Embla Carousels initialization
    const emblaMain = EmblaCarousel(mainNode, {
      loop: false,
      align: 'start',
      axis: 'y',
      watchDrag: (embla) => embla.canScrollPrev() || embla.canScrollNext(),
      breakpoints: {
        [BREAKPOINTS.mobile]: { axis: 'x' },
      },
    });

    const emblaThumbs = EmblaCarousel(thumbsNode, {
      align: 'start',
      containScroll: 'trimSnaps',
      dragFree: true,
      axis: 'y',
      watchDrag: (embla) => embla.canScrollPrev() || embla.canScrollNext(),
      breakpoints: {
        [BREAKPOINTS.mobile]: { axis: 'x' },
      },
    });

    // Update main stage arrow controls and counter
    const updateMainNav = () => {
      const canPrev = emblaMain.canScrollPrev();
      const canNext = emblaMain.canScrollNext();
      const isScrollable = canPrev || canNext;

      if (mainPrevBtn && mainNextBtn) {
        if (!isScrollable) {
          setHiddenIfChanged(mainPrevBtn, true);
          setHiddenIfChanged(mainNextBtn, true);
        } else {
          setHiddenIfChanged(mainPrevBtn, false);
          setHiddenIfChanged(mainNextBtn, false);
          if (mainPrevBtn.disabled !== !canPrev) mainPrevBtn.disabled = !canPrev;
          if (mainNextBtn.disabled !== !canNext) mainNextBtn.disabled = !canNext;
        }
      }
    };

    // Update thumbnails ribbon arrow controls
    const updateThumbsNav = () => {
      if (!prevBtn || !nextBtn) return;

      const canPrev = emblaThumbs.canScrollPrev();
      const canNext = emblaThumbs.canScrollNext();
      const isScrollable = canPrev || canNext;

      if (!isScrollable) {
        setHiddenIfChanged(prevBtn, true);
        setHiddenIfChanged(nextBtn, true);
        return;
      }

      setHiddenIfChanged(prevBtn, false);
      setHiddenIfChanged(nextBtn, false);
      if (prevBtn.disabled !== !canPrev) prevBtn.disabled = !canPrev;
      if (nextBtn.disabled !== !canNext) nextBtn.disabled = !canNext;
    };

    // Keep active thumbnail in view and highlight it
    const syncSelectedThumb = (jump = false) => {
      const selectedIndex = emblaMain.selectedScrollSnap();
      const maxSnap = Math.max(0, emblaThumbs.scrollSnapList().length - 1);
      const targetSnap = Math.max(0, Math.min(maxSnap, selectedIndex - 2));
      if (jump || emblaThumbs.selectedScrollSnap() !== targetSnap) {
        emblaThumbs.scrollTo(targetSnap, jump);
      }

      thumbSlides.forEach((slide, idx) => {
        const isSelected = idx === selectedIndex;
        if (slide.classList.contains('gallery__thumbnail--current') !== isSelected) {
          slide.classList.toggle('gallery__thumbnail--current', isSelected);
        }
        if (isSelected) {
          setAttrIfChanged(slide, 'aria-current', 'true');
        } else if (slide.hasAttribute('aria-current')) {
          slide.removeAttribute('aria-current');
        }
      });

      updateMainNav();
      updateThumbsNav();
      syncPageVideoPlayback();
    };

    interface VideoPlaybackState {
      userPaused: boolean;
      hasControls: boolean;
      currentTime: number;
    }

    // Persistent state memory for page videos by slide index
    const pageVideoStates = new Map<number, VideoPlaybackState>();
    let isPhotoSwipeOpen = false;

    const pageSlideNodes = emblaMain.slideNodes();
    pageSlideNodes.forEach((slide, idx) => {
      if (slide.querySelector('video')) {
        pageVideoStates.set(idx, {
          userPaused: false,
          hasControls: !isMobile(),
          currentTime: 0,
        });
      }
    });

    // Sync page video playback: auto-play active video if not user-paused; pause background videos
    const syncPageVideoPlayback = () => {
      const selectedIndex = emblaMain.selectedScrollSnap();
      const currentSlides = emblaMain.slideNodes();

      currentSlides.forEach((slide, idx) => {
        const video = slide.querySelector<HTMLVideoElement>('video');
        if (!video) return;

        let state = pageVideoStates.get(idx);
        if (!state) {
          state = { userPaused: false, hasControls: !isMobile() };
          pageVideoStates.set(idx, state);
        }

        if (idx === selectedIndex) {
          if (!state.userPaused) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        } else {
          video.pause();
        }
      });
    };

    // PhotoSwipe Lightbox initialization
    const openPhotoSwipe = (initialIndex: number) => {
      isPhotoSwipeOpen = true;
      const currentSlides = emblaMain.slideNodes();
      const mobile = isMobile();

      // Persistent state memory for PhotoSwipe videos by slide index
      const pswpVideoStates = new Map<number, VideoPlaybackState>();

      const dataSource = currentSlides.map((slide, idx) => {
        const video = slide.querySelector<HTMLVideoElement>('video');
        if (video) {
          const videoSrc = video.currentSrc || video.src;
          const poster = video.poster || '';

          // Inherit initial state and playback position from page video
          const pageState = pageVideoStates.get(idx);
          const isPlayingOnPage = !video.paused && !video.ended;
          // If the user was watching the video on the page, continue playing in PhotoSwipe!
          const userPaused = isPlayingOnPage ? false : (pageState ? pageState.userPaused : false);
          const currentTime = video.currentTime || (pageState ? pageState.currentTime : 0);

          pswpVideoStates.set(idx, {
            userPaused,
            hasControls: pageState ? pageState.hasControls : !mobile,
            currentTime,
          });

          return {
            html: `
              <div class="pswp-video-container">
                <video
                  src="${videoSrc}"
                  poster="${poster}"
                  loop
                  muted
                  playsinline
                  preload="auto"
                  data-slide-index="${idx}"
                ></video>
              </div>
            `,
            element: video,
          };
        }

        const img = slide.querySelector<HTMLImageElement>('img.gallery__image');
        const imgSrc = img?.currentSrc || img?.src || '';
        return {
          src: imgSrc,
          width: img?.naturalWidth || 1200,
          height: img?.naturalHeight || 1600,
          alt: img?.alt || '',
          msrc: img?.src || imgSrc,
          element: img || undefined,
        };
      });

      // Pause page videos while lightbox is active
      videos.forEach((v) => v.pause());

      const pswp = new PhotoSwipe({
        dataSource,
        index: initialIndex,
        bgOpacity: 0.95,
        wheelToZoom: true,
        closeOnVerticalDrag: true,
      });

      // Enable ArrowUp/ArrowDown navigation inside PhotoSwipe (next/prev)
      pswp.on('keydown', (e) => {
        const key = e.originalEvent?.key;
        if (key === 'ArrowDown') {
          e.preventDefault();
          e.originalEvent.preventDefault();
          pswp.next();
        } else if (key === 'ArrowUp') {
          e.preventDefault();
          e.originalEvent.preventDefault();
          pswp.prev();
        }
      });

      // Prevent PhotoSwipe from blocking native pointer events on video controls
      pswp.addFilter('preventPointerEvent', (prevent, e) => {
        const target = e.target as HTMLElement | null;
        if (target?.closest('video')) {
          return false;
        }
        return prevent;
      });

      // Prevent PhotoSwipe slide dragging when interacting with video controls
      pswp.on('pointerDown', (e) => {
        const target = e.originalEvent?.target as HTMLElement | null;
        const video = target?.closest('video');
        if (video) {
          const rect = video.getBoundingClientRect();
          const isControlsBar = e.originalEvent.clientY >= rect.bottom - 56;
          if (isControlsBar) {
            e.preventDefault();
          }
        }
      });

      // Prevent zooming when clicking/double-tapping video
      pswp.on('doubleTapAction', (e) => {
        const target = e.originalEvent?.target as HTMLElement | null;
        if (target?.closest('video')) {
          e.preventDefault();
        }
      });

      // Setup video controls and user pause tracking in PhotoSwipe
      pswp.on('contentAppend', ({ content }) => {
        const video = content.element?.querySelector<HTMLVideoElement>('video');
        if (!video) return;

        const slideIdx = content.index;
        video.dataset.slideIndex = String(slideIdx);

        let state = pswpVideoStates.get(slideIdx);
        if (!state) {
          const pageState = pageVideoStates.get(slideIdx);
          state = {
            userPaused: pageState ? pageState.userPaused : false,
            hasControls: pageState ? pageState.hasControls : !mobile,
            currentTime: pageState ? pageState.currentTime : 0,
          };
          pswpVideoStates.set(slideIdx, state);
        }

        // Restore saved playback time so video is not reset to 0:00 when returning to slide
        const targetTime = state.currentTime;
        if (targetTime > 0) {
          const restoreTime = () => {
            try {
              if (Math.abs(video.currentTime - targetTime) > 0.3) {
                video.currentTime = targetTime;
              }
            } catch {}
          };
          if (video.readyState >= 1) {
            restoreTime();
          } else {
            video.addEventListener('loadedmetadata', restoreTime, { once: true });
          }
        }

        // Continuously track video playback position in PhotoSwipe
        video.addEventListener('timeupdate', () => {
          const currentState = pswpVideoStates.get(slideIdx);
          if (currentState) {
            currentState.currentTime = video.currentTime;
          }
        });

        // Apply controls according to state
        if (state.hasControls) {
          video.controls = true;
          video.setAttribute('controlslist', 'nofullscreen');
        } else {
          video.controls = false;
          video.removeAttribute('controlslist');
        }

        // Toggle play/pause or controls on video click
        let wasPausedOnPointerDown = false;
        let pointerDownPos = { x: 0, y: 0 };

        video.addEventListener('pointerdown', (event) => {
          if (isMobile()) return;
          pointerDownPos = { x: event.clientX, y: event.clientY };
          wasPausedOnPointerDown = video.paused;
        });

        video.addEventListener('click', (event) => {
          event.stopPropagation();
          const currentState = pswpVideoStates.get(slideIdx);

          if (isMobile()) {
            if (currentState && !currentState.hasControls) {
              currentState.hasControls = true;
              currentState.userPaused = true;
              video.controls = true;
              video.pause();
            }
            return;
          }

          // If user dragged/swiped slides across the video, ignore click
          const moveDistance = Math.hypot(
            event.clientX - pointerDownPos.x,
            event.clientY - pointerDownPos.y
          );
          if (moveDistance > 6) return;

          // On desktop, clicking video body (outside bottom control bar) toggles playback
          const rect = video.getBoundingClientRect();
          const isControlsBar = event.clientY >= rect.bottom - 56;
          if (!isControlsBar) {
            // Use state recorded at pointerdown before browser's internal click-to-play fired
            if (wasPausedOnPointerDown) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          }
        });

        // Track user-initiated pause in PhotoSwipe
        video.addEventListener('pause', () => {
          const currentState = pswpVideoStates.get(slideIdx);
          if (currentState) {
            currentState.currentTime = video.currentTime;
          }
          // ONLY count as user pause if this video is currently the active slide
          if (pswp.currIndex === slideIdx && !pswp.isDestroying) {
            if (currentState) {
              currentState.userPaused = true;
            }
          }
        });

        video.addEventListener('play', () => {
          if (pswp.currIndex === slideIdx) {
            const currentState = pswpVideoStates.get(slideIdx);
            if (currentState) {
              currentState.userPaused = false;
            }
          }
        });
      });

      // Sync video playback: auto-play active video if not user-paused; pause non-active videos
      const syncPswpVideoPlayback = () => {
        if (!pswp.element) return;
        const currentIdx = pswp.currIndex;
        const pswpVideos = pswp.element.querySelectorAll<HTMLVideoElement>('video');

        pswpVideos.forEach((video) => {
          const slideIdx = Number(video.dataset.slideIndex);
          let state = pswpVideoStates.get(slideIdx);
          if (!state) {
            state = { userPaused: false, hasControls: !mobile, currentTime: 0 };
            pswpVideoStates.set(slideIdx, state);
          }

          if (slideIdx === currentIdx) {
            if (!state.userPaused) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          } else {
            video.pause();
          }
        });
      };

      pswp.on('change', () => {
        syncPswpVideoPlayback();
      });

      pswp.on('contentActivate', () => {
        syncPswpVideoPlayback();
      });

      pswp.on('contentDeactivate', ({ content }) => {
        const video = content.element?.querySelector<HTMLVideoElement>('video');
        if (video) {
          const slideIdx = Number(video.dataset.slideIndex);
          const currentState = pswpVideoStates.get(slideIdx);
          if (currentState) {
            currentState.currentTime = video.currentTime;
          }
          video.pause();
        }
      });

      pswp.on('afterInit', () => {
        syncPswpVideoPlayback();
      });

      // Sync carousel slide when closing lightbox
      pswp.on('close', () => {
        isPhotoSwipeOpen = false;
        // Sync states back to page
        pswpVideoStates.forEach((state, idx) => {
          const pageState = pageVideoStates.get(idx);
          if (pageState) {
            pageState.userPaused = state.userPaused;
            pageState.hasControls = state.hasControls;
            pageState.currentTime = state.currentTime;
          }
        });

        const container = pswp.element;
        container?.querySelectorAll<HTMLVideoElement>('video').forEach((v) => {
          const slideIdx = Number(v.dataset.slideIndex);
          const state = pswpVideoStates.get(slideIdx);
          if (state) state.currentTime = v.currentTime;
          v.pause();
        });

        const targetIndex = pswp.currIndex;
        emblaMain.scrollTo(targetIndex, true);
        syncSelectedThumb(true);

        // Sync currentTime and state to active page video
        const activeSlide = emblaMain.slideNodes()[targetIndex];
        const activePageVideo = activeSlide?.querySelector<HTMLVideoElement>('video');
        const activePageState = pageVideoStates.get(targetIndex);
        if (activePageVideo && activePageState && activePageState.currentTime > 0) {
          try {
            activePageVideo.currentTime = activePageState.currentTime;
          } catch {}
        }
        syncPageVideoPlayback();
      });

      pswp.init();
    };

    // Open PhotoSwipe by clicking main slide (ignore direct video clicks)
    mainNode.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      if (target.closest('video') || target.tagName === 'VIDEO') return;

      const slide = target.closest('.gallery__item');
      if (!slide) return;

      const slides = emblaMain.slideNodes();
      const index = slides.indexOf(slide as HTMLElement);
      if (index !== -1) {
        openPhotoSwipe(index);
      }
    });

    // Gallery focus tracking (for Up/Down page navigation)
    let isGalleryFocused = false;

    window.addEventListener('click', (event) => {
      isGalleryFocused = galleryRoot.contains(event.target as Node);
    });

    window.addEventListener(
      'scroll',
      () => {
        isGalleryFocused = false;
      },
      { passive: true }
    );

    galleryRoot.addEventListener('focusin', () => {
      isGalleryFocused = true;
    });

    galleryRoot.addEventListener('focusout', (event) => {
      if (!galleryRoot.contains(event.relatedTarget as Node)) {
        isGalleryFocused = false;
      }
    });

    // Keyboard navigation for embedded gallery (blocked in modals, PhotoSwipe, and form inputs)
    window.addEventListener('keydown', (event) => {
      if (
        isEditableTarget(event.target) ||
        isEditableTarget(document.activeElement) ||
        document.querySelector('.pswp--open') ||
        document.documentElement.classList.contains('hystmodal__opened') ||
        document.querySelector('.hystmodal--active') ||
        document.querySelector('dialog[open]')
      ) {
        return;
      }

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        emblaMain.scrollPrev();
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        emblaMain.scrollNext();
      } else if (isGalleryFocused) {
        if (event.key === 'ArrowUp') {
          event.preventDefault();
          emblaMain.scrollPrev();
        } else if (event.key === 'ArrowDown') {
          event.preventDefault();
          emblaMain.scrollNext();
        }
      }
    });

    // Thumbnail click switches main photo
    thumbSlides.forEach((slide, index) => {
      slide.addEventListener('click', () => {
        emblaMain.scrollTo(index);
      });
    });

    // Main stage prev/next buttons
    if (mainPrevBtn) {
      mainPrevBtn.addEventListener('click', () => {
        emblaMain.scrollPrev();
      });
    }

    if (mainNextBtn) {
      mainNextBtn.addEventListener('click', () => {
        emblaMain.scrollNext();
      });
    }

    // Thumbnail ribbon prev/next buttons
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        const target = Math.max(0, emblaThumbs.selectedScrollSnap() - THUMBS_SCROLL_STEP);
        emblaThumbs.scrollTo(target);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const maxSnap = emblaThumbs.scrollSnapList().length - 1;
        const target = Math.min(maxSnap, emblaThumbs.selectedScrollSnap() + THUMBS_SCROLL_STEP);
        emblaThumbs.scrollTo(target);
      });
    }

    // Video fullscreen button in top-right corner opens PhotoSwipe
    const videoFsBtns = Array.from(
      galleryRoot.querySelectorAll<HTMLButtonElement>('[data-gallery-video-fs]')
    );

    videoFsBtns.forEach((btn) => {
      btn.addEventListener('click', (event) => {
        event.stopPropagation();
        const slide = btn.closest('.gallery__item');
        const slides = emblaMain.slideNodes();
        const index = slide ? slides.indexOf(slide as HTMLElement) : -1;
        if (index !== -1) {
          openPhotoSwipe(index);
        }
      });

      btn.addEventListener('pointerdown', (event) => {
        event.stopPropagation();
      });
    });

    // Native controls on desktop only (avoids iOS Safari full-frame dark overlay with huge skip buttons)
    const updateVideoControlsForDevice = () => {
      const mobile = isMobile();
      videos.forEach((video) => {
        const slide = video.closest('.gallery__item');
        const videoSlideIndex = slide ? pageSlideNodes.indexOf(slide as HTMLElement) : -1;
        const state = pageVideoStates.get(videoSlideIndex);

        if (mobile) {
          const showControls = state ? state.hasControls : false;
          video.controls = showControls;
          if (!showControls) video.removeAttribute('controlslist');
        } else {
          video.controls = true;
          video.setAttribute('controlslist', 'nofullscreen');
          if (state) state.hasControls = true;
        }
      });
    };
    updateVideoControlsForDevice();
    window.addEventListener('resize', updateVideoControlsForDevice);

    // Video interaction and playback tracking
    videos.forEach((video) => {
      const slide = video.closest('.gallery__item');
      const videoSlideIndex = slide ? pageSlideNodes.indexOf(slide as HTMLElement) : -1;

      let wasPausedOnPointerDown = false;
      let pointerDownPos = { x: 0, y: 0 };

      video.addEventListener('pointerdown', (event) => {
        if (isMobile()) return;
        pointerDownPos = { x: event.clientX, y: event.clientY };
        wasPausedOnPointerDown = video.paused;
      });

      video.addEventListener('click', (event) => {
        event.stopPropagation();
        const state = pageVideoStates.get(videoSlideIndex);

        if (isMobile()) {
          if (state && !state.hasControls) {
            state.hasControls = true;
            state.userPaused = true;
            video.controls = true;
            video.pause();
          }
          return;
        }

        // If user dragged/swiped carousel across the video, ignore click
        const moveDistance = Math.hypot(
          event.clientX - pointerDownPos.x,
          event.clientY - pointerDownPos.y
        );
        if (moveDistance > 6) return;

        // On desktop, clicking video body (outside bottom control bar) toggles playback
        const rect = video.getBoundingClientRect();
        const isControlsBar = event.clientY >= rect.bottom - 56;
        if (!isControlsBar) {
          if (wasPausedOnPointerDown) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      });

      video.addEventListener('timeupdate', () => {
        const state = pageVideoStates.get(videoSlideIndex);
        if (state) {
          state.currentTime = video.currentTime;
        }
      });

      // Track user-initiated pause/play on active slide
      video.addEventListener('pause', () => {
        const currentSlideIndex = emblaMain.selectedScrollSnap();
        if (
          videoSlideIndex === currentSlideIndex &&
          !isPhotoSwipeOpen &&
          !document.querySelector('.pswp--open')
        ) {
          const state = pageVideoStates.get(videoSlideIndex);
          if (state) {
            state.userPaused = true;
            state.currentTime = video.currentTime;
          }
        }
      });

      video.addEventListener('play', () => {
        const currentSlideIndex = emblaMain.selectedScrollSnap();
        if (videoSlideIndex === currentSlideIndex) {
          const state = pageVideoStates.get(videoSlideIndex);
          if (state) state.userPaused = false;
        }
      });
    });

    // Grabbing cursor management (only when actively dragging)
    const bindDragCursor = (embla: ReturnType<typeof EmblaCarousel>) => {
      let isPointerDown = false;
      embla.on('pointerDown', () => {
        isPointerDown = true;
      });
      embla.on('scroll', () => {
        if (isPointerDown) {
          document.documentElement.classList.add('is-dragging');
        }
      });
      embla.on('pointerUp', () => {
        isPointerDown = false;
        document.documentElement.classList.remove('is-dragging');
      });
      embla.on('settle', () => {
        document.documentElement.classList.remove('is-dragging');
      });
    };

    bindDragCursor(emblaMain);
    bindDragCursor(emblaThumbs);

    // Embla event subscriptions
    emblaMain.on('init', updateMainNav);
    emblaMain.on('select', () => {
      syncSelectedThumb(false);
      syncPageVideoPlayback();
    });
    emblaMain.on('reInit', () => {
      syncSelectedThumb(true);
      syncPageVideoPlayback();
    });

    emblaThumbs.on('init', updateThumbsNav);
    emblaThumbs.on('reInit', updateThumbsNav);
    emblaThumbs.on('select', updateThumbsNav);

    // Initial state setup
    updateMainNav();
    updateThumbsNav();
    syncPageVideoPlayback();
  });
</script>
