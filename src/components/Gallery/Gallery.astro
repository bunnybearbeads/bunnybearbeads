---
import './Gallery.css';
import './GalleryArrows.css';
import './GalleryFullScreen.css';
import Icon from '../Icon/Icon.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  images: (string | { type?: 'image' | 'video'; src: string; poster?: string })[];
  alt: string;
  lang?: SupportedLanguage;
}

const { images = [], alt, lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

interface MediaItem {
  type: 'image' | 'video';
  src: string;
  poster?: string;
}

const items: MediaItem[] = images.map((item) => {
  if (typeof item === 'string') {
    const isVideo = /\.(mp4|webm|ogg|mov)$/i.test(item);
    return {
      type: isVideo ? 'video' : 'image',
      src: item,
      poster: isVideo ? item.replace(/\.[^.]+$/, '.jpg') : undefined,
    };
  }
  const isVideo = item.type === 'video' || /\.(mp4|webm|ogg|mov)$/i.test(item.src);
  return {
    type: isVideo ? 'video' : 'image',
    src: item.src,
    poster: item.poster || (isVideo ? item.src.replace(/\.[^.]+$/, '.jpg') : undefined),
  };
});
---

<div class="gallery" data-gallery>
  <div class="gallery__navigation" data-gallery-thumbs-col>
    <button
      class="gallery__control gallery__control--prev"
      data-gallery-thumbs-prev
      aria-label={t('gallery.thumbs_prev')}
      tabindex="-1"
      type="button"
      hidden
    >
      <Icon name="keyboard_arrow_up" />
    </button>

    <div class="gallery__nav-viewport" data-gallery-thumbs>
      <div class="gallery__nav-ribbon" aria-label={t('gallery.thumbs_ribbon')}>
        {items.map((item, index) => {
          const thumbSrc = item.type === 'video' ? (item.poster || item.src) : item.src;
          const mediaLabel = item.type === 'video' ? t('gallery.video') : t('gallery.photo');
          return (
            <button
              class:list={[
                'gallery__thumbnail',
                { 'gallery__thumbnail--current': index === 0 },
                { 'gallery__thumbnail--video': item.type === 'video' },
              ]}
              data-gallery-thumb-slide
              aria-label={`${alt} — ${mediaLabel} ${index + 1}`}
              aria-current={index === 0 ? 'true' : undefined}
              tabindex="-1"
              type="button"
            >
              <img
                class="gallery__thumb-image"
                src={thumbSrc}
                alt={`${alt} — ${t('gallery.preview')} ${index + 1}`}
                loading={index >= 5 ? 'lazy' : undefined}
              />
              {item.type === 'video' && (
                <span class="gallery__thumb-play" aria-hidden="true">
                  <Icon name="play_arrow" />
                </span>
              )}
            </button>
          );
        })}
      </div>
    </div>

    <button
      class="gallery__control gallery__control--next"
      data-gallery-thumbs-next
      aria-label={t('gallery.thumbs_next')}
      tabindex="-1"
      type="button"
      hidden
    >
      <Icon name="keyboard_arrow_down" />
    </button>
  </div>

  <div class="gallery__stage" data-gallery-stage-col>
    <button
      class="gallery__control gallery__control--stage gallery__control--prev"
      data-gallery-main-prev
      aria-label={t('gallery.main_prev')}
      type="button"
      hidden
    >
      <Icon name="keyboard_arrow_up" />
    </button>

    <div class="gallery__viewport">
      <div class="gallery__strut" data-gallery-main>
        <div class="gallery__ribbon">
          {items.map((item, index) => (
            <div class="gallery__item">
              {item.type === 'video' ? (
                <video
                  class="gallery__image gallery__image--video"
                  src={item.src}
                  poster={item.poster}
                  autoplay
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  data-gallery-video
                />
                <div class="gallery__video-click-area" data-gallery-video-click-area />
                <button
                  class="gallery__video-fs"
                  data-gallery-video-fs
                  aria-label={t('gallery.fullscreen')}
                  type="button"
                >
                  <Icon name="open_in_full" />
                </button>
              ) : (
                <img
                  class="gallery__image"
                  src={item.src}
                  alt={index === 0 ? alt : `${alt} — ${t('gallery.photo')} ${index + 1}`}
                  fetchpriority={index === 0 ? 'high' : 'low'}
                  loading={index === 0 ? undefined : 'lazy'}
                />
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    <button
      class="gallery__control gallery__control--stage gallery__control--next"
      data-gallery-main-next
      aria-label={t('gallery.main_next')}
      type="button"
      hidden
    >
      <Icon name="keyboard_arrow_down" />
    </button>
  </div>

  <div class="gallery__fs-panel">
    <button
      class="gallery__close"
      data-gallery-fs-close
      aria-label={t('gallery.close')}
      type="button"
    >
      <Icon name="close" />
    </button>
    <div class="gallery__counter" data-gallery-fs-counter>
      1 / {items.length}
    </div>
  </div>

</div>

<script>
  /* AI (whole script) */
  import EmblaCarousel from 'embla-carousel';
  import {
    isMobile,
    BREAKPOINTS,
    setAttrIfChanged,
    setHiddenIfChanged,
    isEditableTarget,
  } from '../../utils';

  const THUMBS_SCROLL_STEP = 4;
  const galleries = document.querySelectorAll<HTMLElement>('[data-gallery]');

  galleries.forEach((galleryRoot) => {
    const mainNode = galleryRoot.querySelector<HTMLElement>('[data-gallery-main]');
    const thumbsNode = galleryRoot.querySelector<HTMLElement>('[data-gallery-thumbs]');
    const mainPrevBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-main-prev]');
    const mainNextBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-main-next]');
    const prevBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-thumbs-prev]');
    const nextBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-thumbs-next]');
    const fsCounter = galleryRoot.querySelector<HTMLElement>('[data-gallery-fs-counter]');
    const fsCloseBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-fs-close]');
    const videos = Array.from(
      galleryRoot.querySelectorAll<HTMLVideoElement>('[data-gallery-video]')
    );
    const thumbSlides = Array.from(
      galleryRoot.querySelectorAll<HTMLElement>('[data-gallery-thumb-slide]')
    );

    if (!mainNode || !thumbsNode) return;

    // Embla Carousels initialization
    const emblaMain = EmblaCarousel(mainNode, {
      loop: false,
      align: 'start',
      axis: 'y',
      watchDrag: (embla) => embla.canScrollPrev() || embla.canScrollNext(),
      breakpoints: {
        [BREAKPOINTS.mobile]: { axis: 'x' },
      },
    });

    const emblaThumbs = EmblaCarousel(thumbsNode, {
      align: 'start',
      containScroll: 'trimSnaps',
      dragFree: true,
      axis: 'y',
      watchDrag: (embla) => embla.canScrollPrev() || embla.canScrollNext(),
      breakpoints: {
        [BREAKPOINTS.mobile]: { axis: 'x' },
      },
    });

    // Update main stage arrow controls and counter
    const updateMainNav = () => {
      const canPrev = emblaMain.canScrollPrev();
      const canNext = emblaMain.canScrollNext();
      const isScrollable = canPrev || canNext;

      if (mainPrevBtn && mainNextBtn) {
        if (!isScrollable) {
          setHiddenIfChanged(mainPrevBtn, true);
          setHiddenIfChanged(mainNextBtn, true);
        } else {
          setHiddenIfChanged(mainPrevBtn, false);
          setHiddenIfChanged(mainNextBtn, false);
          if (mainPrevBtn.disabled !== !canPrev) mainPrevBtn.disabled = !canPrev;
          if (mainNextBtn.disabled !== !canNext) mainNextBtn.disabled = !canNext;
        }
      }

      if (fsCounter) {
        const nextText = `${emblaMain.selectedScrollSnap() + 1} / ${thumbSlides.length}`;
        if (fsCounter.textContent !== nextText) {
          fsCounter.textContent = nextText;
        }
      }
    };

    // Update thumbnails ribbon arrow controls
    const updateThumbsNav = () => {
      if (!prevBtn || !nextBtn) return;

      const canPrev = emblaThumbs.canScrollPrev();
      const canNext = emblaThumbs.canScrollNext();
      const isScrollable = canPrev || canNext;

      if (!isScrollable) {
        setHiddenIfChanged(prevBtn, true);
        setHiddenIfChanged(nextBtn, true);
        return;
      }

      setHiddenIfChanged(prevBtn, false);
      setHiddenIfChanged(nextBtn, false);
      if (prevBtn.disabled !== !canPrev) prevBtn.disabled = !canPrev;
      if (nextBtn.disabled !== !canNext) nextBtn.disabled = !canNext;
    };

    // Keep active thumbnail in view and highlight it
    const syncSelectedThumb = (jump = false) => {
      const selectedIndex = emblaMain.selectedScrollSnap();
      const maxSnap = Math.max(0, emblaThumbs.scrollSnapList().length - 1);
      const targetSnap = Math.max(0, Math.min(maxSnap, selectedIndex - 2));
      if (jump || emblaThumbs.selectedScrollSnap() !== targetSnap) {
        emblaThumbs.scrollTo(targetSnap, jump);
      }

      thumbSlides.forEach((slide, idx) => {
        const isSelected = idx === selectedIndex;
        if (slide.classList.contains('gallery__thumbnail--current') !== isSelected) {
          slide.classList.toggle('gallery__thumbnail--current', isSelected);
        }
        if (isSelected) {
          setAttrIfChanged(slide, 'aria-current', 'true');
        } else if (slide.hasAttribute('aria-current')) {
          slide.removeAttribute('aria-current');
        }
      });

      updateMainNav();
      updateThumbsNav();
      syncVideoPlayback();
    };

    // NOTE: In the HTML5 spec, calling video.pause() dispatches the 'pause' event asynchronously
    // via the browser's task queue. Thus a simple boolean flag cannot be set and cleared synchronously.
    // Instead, we track `isSlideChanging` during carousel transitions and verify slide index in the event.
    let isSlideChanging = false;

    // Sync video playback: resume video if user left it playing, pause in background when away
    const syncVideoPlayback = () => {
      const selectedIndex = emblaMain.selectedScrollSnap();
      const slides = emblaMain.slideNodes();
      slides.forEach((slide, idx) => {
        const video = slide.querySelector<HTMLVideoElement>('video');
        if (video) {
          if (idx === selectedIndex) {
            // Keep the exact state user left it in: if user stopped it, keep paused; otherwise play
            if (video.dataset.userPaused !== 'true') {
              video.play().catch(() => {});
            }
          } else {
            video.pause();
          }
        }
      });
    };

    // Fullscreen mode state & handlers
    let isFullscreen = false;
    let savedScrollY = 0;
    const placeholder = document.createComment('gallery-placeholder');

    const setFullscreen = (nextState: boolean) => {
      if (nextState === isFullscreen) return;
      if (nextState && isMobile()) return;

      if (nextState) {
        savedScrollY = window.scrollY;
        isFullscreen = true;
        galleryRoot.before(placeholder);
        document.body.appendChild(galleryRoot);
        document.documentElement.classList.add('is-gallery-fullscreen');
      } else {
        isFullscreen = false;
        if (placeholder.parentNode) {
          placeholder.replaceWith(galleryRoot);
        }
        document.documentElement.classList.remove('is-gallery-fullscreen');
        window.scrollTo(0, savedScrollY);
      }

      document.documentElement.classList.remove('is-dragging');

      const currentIndex = emblaMain.selectedScrollSnap();
      emblaMain.reInit();
      emblaThumbs.reInit();
      emblaMain.scrollTo(currentIndex, true);
      syncSelectedThumb(true);
    };

    // Open fullscreen by clicking main slide (desktop only; ignore video clicks)
    mainNode.addEventListener('click', (event) => {
      if (isMobile()) return;
      const target = event.target as HTMLElement | null;
      if (target && (target.closest('video') || target.tagName === 'VIDEO')) return;
      if (!isFullscreen) {
        setFullscreen(true);
      }
    });

    // Close fullscreen by clicking close button
    if (fsCloseBtn) {
      fsCloseBtn.addEventListener('click', () => {
        setFullscreen(false);
      });
    }

    // Close fullscreen by clicking empty backdrop
    galleryRoot.addEventListener('click', (event) => {
      if (!isFullscreen) return;
      if (event.target === galleryRoot) {
        setFullscreen(false);
      }
    });

    // Gallery focus tracking (for Up/Down page navigation)
    let isGalleryFocused = false;

    window.addEventListener('click', (event) => {
      isGalleryFocused = galleryRoot.contains(event.target as Node);
    });

    window.addEventListener(
      'scroll',
      () => {
        if (!isFullscreen) {
          isGalleryFocused = false;
        }
      },
      { passive: true }
    );

    galleryRoot.addEventListener('focusin', () => {
      isGalleryFocused = true;
    });

    galleryRoot.addEventListener('focusout', (event) => {
      if (!galleryRoot.contains(event.relatedTarget as Node)) {
        isGalleryFocused = false;
      }
    });

    // Consolidated keyboard navigation
    window.addEventListener('keydown', (event) => {
      if (isEditableTarget(event.target)) return;

      if (isFullscreen) {
        if (event.key === 'Escape') {
          event.preventDefault();
          setFullscreen(false);
        } else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
          event.preventDefault();
          emblaMain.scrollPrev();
        } else if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
          event.preventDefault();
          emblaMain.scrollNext();
        }
        return;
      }

      // Embedded gallery on page
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        emblaMain.scrollPrev();
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        emblaMain.scrollNext();
      } else if (isGalleryFocused) {
        if (event.key === 'ArrowUp') {
          event.preventDefault();
          emblaMain.scrollPrev();
        } else if (event.key === 'ArrowDown') {
          event.preventDefault();
          emblaMain.scrollNext();
        }
      }
    });

    // Thumbnail click switches main photo
    thumbSlides.forEach((slide, index) => {
      slide.addEventListener('click', () => {
        emblaMain.scrollTo(index);
      });
    });

    // Main stage prev/next buttons
    if (mainPrevBtn) {
      mainPrevBtn.addEventListener('click', () => {
        emblaMain.scrollPrev();
      });
    }

    if (mainNextBtn) {
      mainNextBtn.addEventListener('click', () => {
        emblaMain.scrollNext();
      });
    }

    // Thumbnail ribbon prev/next buttons
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        const target = Math.max(0, emblaThumbs.selectedScrollSnap() - THUMBS_SCROLL_STEP);
        emblaThumbs.scrollTo(target);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const maxSnap = emblaThumbs.scrollSnapList().length - 1;
        const target = Math.min(maxSnap, emblaThumbs.selectedScrollSnap() + THUMBS_SCROLL_STEP);
        emblaThumbs.scrollTo(target);
      });
    }

    // Video fullscreen button in top-right corner
    const videoFsBtns = Array.from(
      galleryRoot.querySelectorAll<HTMLButtonElement>('[data-gallery-video-fs]')
    );

    videoFsBtns.forEach((btn) => {
      btn.addEventListener('click', (event) => {
        event.stopPropagation();
        if (!isFullscreen) {
          setFullscreen(true);
        }
      });

      btn.addEventListener('pointerdown', (event) => {
        event.stopPropagation();
      });
    });

    // Clicking video frame (outside bottom controls) toggles play/pause cleanly
    const videoClickAreas = Array.from(
      galleryRoot.querySelectorAll<HTMLElement>('[data-gallery-video-click-area]')
    );

    videoClickAreas.forEach((area) => {
      const item = area.closest('.gallery__item');
      const video = item?.querySelector<HTMLVideoElement>('[data-gallery-video]');
      if (!video) return;

      area.addEventListener('click', (event) => {
        event.stopPropagation();
        if (video.paused) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    });

    // Native controls on desktop only (avoids iOS Safari full-frame dark overlay with huge skip buttons)
    const updateVideoControlsForDevice = () => {
      const mobile = isMobile();
      videos.forEach((video) => {
        if (mobile) {
          video.controls = false;
          video.removeAttribute('controlslist');
        } else {
          video.controls = true;
          video.setAttribute('controlslist', 'nofullscreen');
        }
      });
    };
    updateVideoControlsForDevice();
    window.addEventListener('resize', updateVideoControlsForDevice);

    // On mobile, videos initially start without `controls` to avoid iOS Safari rendering a heavy
    // full-frame dark scrim overlay with large rewind/fast-forward buttons across the product.
    // When the user taps the video:
    // 1) We dynamically reveal native controls (`video.controls = true`).
    // 2) We immediately pause playback (`video.pause()`) because the user's primary intent when tapping
    //    a playing video is to pause it, not just reveal the interface.
    // This allows the user to inspect the frame, scrub the timeline, or resume via the center Play button.
    videos.forEach((video) => {
      video.addEventListener('click', (event) => {
        if (!isMobile()) return;
        event.stopPropagation();
        if (!video.controls) {
          video.controls = true;
          video.pause();
        }
      });
    });

    // Track user-initiated pause/play across all devices (persists paused state on navigation).
    // IMPORTANT: video.pause() called during slide navigation is asynchronous in HTML5 and
    // triggers a 'pause' event on the next task tick. To ensure background pauses are NOT mistaken
    // for manual user pauses, we verify that:
    // 1) The pause happened while this video was the active slide (videoSlideIndex === currentSlideIndex).
    // 2) Embla is not actively transitioning/changing slides (!isSlideChanging).
    videos.forEach((video) => {
      const slide = video.closest('.gallery__item');
      video.addEventListener('pause', () => {
        const slides = emblaMain.slideNodes();
        const videoSlideIndex = slide ? slides.indexOf(slide as HTMLElement) : -1;
        const currentSlideIndex = emblaMain.selectedScrollSnap();

        // Only mark as userPaused if paused while active slide and NOT during slide transition
        if (!isSlideChanging && videoSlideIndex === currentSlideIndex) {
          video.dataset.userPaused = 'true';
        }
      });

      video.addEventListener('play', () => {
        video.dataset.userPaused = 'false';
      });
    });

    // Wheel scroll handler (fullscreen desktop only, with trackpad inertia debounce)
    const bindWheelScroll = (
      targetEl: HTMLElement,
      embla: ReturnType<typeof EmblaCarousel>,
      stepCount = 1
    ) => {
      let isWheelLocked = false;
      let lastTriggerTime = 0;
      let prevAbsDelta = 0;
      let unlockTimer: number | undefined;

      targetEl.addEventListener(
        'wheel',
        (event) => {
          if (!isFullscreen || isMobile()) return;

          const canPrev = embla.canScrollPrev();
          const canNext = embla.canScrollNext();
          if (!canPrev && !canNext) return;

          event.preventDefault();

          const absDelta = Math.abs(event.deltaY);
          const now = performance.now();

          window.clearTimeout(unlockTimer);
          unlockTimer = window.setTimeout(() => {
            isWheelLocked = false;
            prevAbsDelta = 0;
          }, 80);

          // Unlock early if user initiates a new finger flick during trackpad inertia decay
          if (
            isWheelLocked &&
            now - lastTriggerTime > 220 &&
            absDelta > prevAbsDelta * 1.6 &&
            absDelta > 16
          ) {
            isWheelLocked = false;
          }
          prevAbsDelta = absDelta;

          if (isWheelLocked || absDelta < 6) return;
          if ((event.deltaY < 0 && !canPrev) || (event.deltaY > 0 && !canNext)) return;

          isWheelLocked = true;
          lastTriggerTime = now;

          const direction = event.deltaY > 0 ? 1 : -1;
          const maxSnap = embla.scrollSnapList().length - 1;
          const target = Math.max(
            0,
            Math.min(maxSnap, embla.selectedScrollSnap() + direction * stepCount)
          );
          embla.scrollTo(target);
        },
        { passive: false }
      );
    };

    const thumbsCol = galleryRoot.querySelector<HTMLElement>('[data-gallery-thumbs-col]') || thumbsNode;
    const stageCol = galleryRoot.querySelector<HTMLElement>('[data-gallery-stage-col]') || mainNode;

    bindWheelScroll(thumbsCol, emblaThumbs, THUMBS_SCROLL_STEP);
    bindWheelScroll(stageCol, emblaMain, 1);

    // Grabbing cursor management (only when actively dragging)
    const bindDragCursor = (embla: ReturnType<typeof EmblaCarousel>) => {
      let isPointerDown = false;
      embla.on('pointerDown', () => {
        isPointerDown = true;
      });
      embla.on('scroll', () => {
        if (isPointerDown) {
          document.documentElement.classList.add('is-dragging');
        }
      });
      embla.on('pointerUp', () => {
        isPointerDown = false;
        document.documentElement.classList.remove('is-dragging');
      });
      embla.on('settle', () => {
        document.documentElement.classList.remove('is-dragging');
      });
    };

    bindDragCursor(emblaMain);
    bindDragCursor(emblaThumbs);

    // Embla event subscriptions
    emblaMain.on('init', updateMainNav);
    emblaMain.on('select', () => {
      isSlideChanging = true;
      syncSelectedThumb(false);
      window.setTimeout(() => {
        isSlideChanging = false;
      }, 50);
    });
    emblaMain.on('reInit', () => {
      isSlideChanging = true;
      syncSelectedThumb(true);
      window.setTimeout(() => {
        isSlideChanging = false;
      }, 50);
    });

    emblaThumbs.on('init', updateThumbsNav);
    emblaThumbs.on('reInit', updateThumbsNav);
    emblaThumbs.on('select', updateThumbsNav);

    // Initial state setup
    updateMainNav();
    updateThumbsNav();
    syncVideoPlayback();
  });
</script>
