---
import './Gallery.css';
import './GalleryArrows.css';
import 'photoswipe/style.css';
import Icon from '../Icon/Icon.astro';
import Photo from '../Photo/Photo.astro';
import { photoLarge } from '../../utils/photos';
import type { ProductData } from '../../utils/products';
import { type SupportedLanguage } from '../../i18n/ui';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  images: ProductData['images'];
  alt: string;
  lang?: SupportedLanguage;
}

const { images = [], alt, lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Постер видео без своего — кадр из видео рядом (.jpg), его делает scripts/generate-posters.mjs при экспорте
const posterOf = (video: Extract<ProductData['images'][number], { type: 'video' }>) =>
  video.poster ?? video.src.replace(/\.[^.]+$/, '.jpg');

/** Галерея — фото изделия на странице. Ширина на странице: на мобильном — весь экран, на десктопе — ~560px */
const STAGE_SIZES = '(width < 740px) 100vw, 560px';
---

<div class="gallery" data-gallery>
  <div class="gallery__navigation" data-gallery-thumbs-col tabindex="0">
    <button
      class="gallery__control gallery__control--prev"
      data-gallery-thumbs-prev
      aria-label={t('gallery.thumbs_prev')}
      tabindex="-1"
      type="button"
      hidden
    >
      <Icon name="keyboard_arrow_up" />
    </button>

    <div class="gallery__nav-viewport" data-gallery-thumbs>
      <div class="gallery__nav-ribbon" aria-label={t('gallery.thumbs_ribbon')}>
        {images.map((item, index) => {
          const mediaLabel = item.type === 'video' ? t('gallery.video') : t('gallery.photo');
          return (
            <button
              class:list={[
                'gallery__thumbnail',
                { 'gallery__thumbnail--current': index === 0 },
                { 'gallery__thumbnail--video': item.type === 'video' },
              ]}
              data-gallery-thumb-slide
              aria-label={`${alt} — ${mediaLabel} ${index + 1}`}
              aria-current={index === 0 ? 'true' : undefined}
              tabindex="-1"
              type="button"
            >
              {item.type === 'video' ? (
                <img
                  class="gallery__thumb-image"
                  src={posterOf(item)}
                  alt={`${alt} — ${t('gallery.preview')} ${index + 1}`}
                  loading={index >= 5 ? 'lazy' : undefined}
                />
              ) : (
                <Photo
                  class="gallery__thumb-image"
                  photo={item}
                  sizes="98px"
                  maxWidth={720}
                  alt={`${alt} — ${t('gallery.preview')} ${index + 1}`}
                  loading={index >= 5 ? 'lazy' : undefined}
                />
              )}
              {item.type === 'video' && (
                <span class="gallery__thumb-play" aria-hidden="true">
                  <Icon name="play_arrow" />
                </span>
              )}
            </button>
          );
        })}
      </div>
    </div>

    <button
      class="gallery__control gallery__control--next"
      data-gallery-thumbs-next
      aria-label={t('gallery.thumbs_next')}
      tabindex="-1"
      type="button"
      hidden
    >
      <Icon name="keyboard_arrow_down" />
    </button>
  </div>

  <div class="gallery__stage" data-gallery-stage-col>
    <button
      class="gallery__control gallery__control--stage gallery__control--prev"
      data-gallery-main-prev
      aria-label={t('gallery.main_prev')}
      type="button"
      hidden
    >
      <Icon name="keyboard_arrow_up" />
    </button>

    <div class="gallery__viewport">
      <div class="gallery__strut" data-gallery-main>
        <div class="gallery__ribbon">
          {images.map((item, index) => (
            <div class="gallery__item">
              {item.type === 'video' ? (
                <video
                  class="gallery__image gallery__image--video"
                  src={item.src}
                  poster={posterOf(item)}
                  autoplay
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  data-gallery-video
                />
                <button
                  class="gallery__full-screen-handler"
                  data-gallery-video-fs
                  aria-label={t('gallery.fullscreen')}
                  type="button"
                >
                  <Icon name="open_in_full" />
                </button>
              ) : (
                <Photo
                  class="gallery__image"
                  photo={item}
                  sizes={STAGE_SIZES}
                  maxWidth={1440}
                  alt={index === 0 ? alt : `${alt} — ${t('gallery.photo')} ${index + 1}`}
                  fetchpriority={index === 0 ? 'high' : 'low'}
                  loading={index === 0 ? undefined : 'lazy'}
                  data-pswp-avif={photoLarge(item).avif}
                  data-pswp-jpg={photoLarge(item).jpg}
                  data-pswp-width={photoLarge(item).width}
                  data-pswp-height={photoLarge(item).height}
                />
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    <button
      class="gallery__control gallery__control--stage gallery__control--next"
      data-gallery-main-next
      aria-label={t('gallery.main_next')}
      type="button"
      hidden
    >
      <Icon name="keyboard_arrow_down" />
    </button>
  </div>
</div>

<script>
  import { initGalleries } from './gallery';
  initGalleries();
</script>
