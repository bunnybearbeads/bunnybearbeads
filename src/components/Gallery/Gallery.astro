---
import './Gallery.css';

interface Props {
  images?: string[];
  alt: string;
}

const { images = [], alt } = Astro.props;
const hasImages = images.length > 0;
---

<div class="gallery" data-gallery>
  {hasImages && (
    <div class="gallery__thumbs-column" data-gallery-thumbs-col>
      <button
        type="button"
        class="gallery__thumbs-nav gallery__thumbs-nav--prev"
        data-gallery-thumbs-prev
        aria-label="Previous thumbnails"
        hidden
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </button>

      <div class="gallery__thumbs-viewport" data-gallery-thumbs>
        <ul class="gallery__thumbs" aria-label="Product thumbnails">
          {images.map((src, index) => (
            <li
              class:list={[
                'gallery__thumb-item',
                { 'gallery__thumb-item--active': index === 0 },
              ]}
              data-gallery-thumb-slide
            >
              <button
                type="button"
                class="gallery__thumb-btn"
                aria-label={`${alt} — photo ${index + 1}`}
                aria-current={index === 0 ? 'true' : undefined}
              >
                <img
                  src={src}
                  alt={`${alt} — preview ${index + 1}`}
                  class="gallery__thumb-img"
                  loading={index >= 5 ? 'lazy' : undefined}
                />
              </button>
            </li>
          ))}
        </ul>
      </div>

      <button
        type="button"
        class="gallery__thumbs-nav gallery__thumbs-nav--next"
        data-gallery-thumbs-next
        aria-label="Next thumbnails"
        hidden
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </div>
  )}

  <div class="gallery__stage-column">
    {hasImages && (
      <button
        type="button"
        class="gallery__thumbs-nav gallery__stage-nav gallery__thumbs-nav--prev"
        data-gallery-main-prev
        aria-label="Previous photo"
        hidden
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </button>
    )}

    <div class="gallery__stage" data-gallery-main>
      {hasImages ? (
        <div class="gallery__stage-track">
          {images.map((src, index) => (
            <div class="gallery__stage-slide">
              <img
                src={src}
                alt={index === 0 ? alt : `${alt} — photo ${index + 1}`}
                class="gallery__main-img"
                fetchpriority={index === 0 ? 'high' : 'low'}
                loading={index === 0 ? undefined : 'lazy'}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="gallery__placeholder">
          <span class="gallery__placeholder-icon" aria-hidden="true">📿</span>
          <span class="gallery__placeholder-caption">BunnyBearBeads Masterpiece</span>
        </div>
      )}
    </div>

    {hasImages && (
      <button
        type="button"
        class="gallery__thumbs-nav gallery__stage-nav gallery__thumbs-nav--next"
        data-gallery-main-next
        aria-label="Next photo"
        hidden
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    )}
  </div>

  {hasImages && (
    <div class="gallery__fs-controls" data-gallery-fs-controls>
      <button
        type="button"
        class="gallery__fs-btn gallery__fs-btn--close"
        data-gallery-fs-close
        aria-label="Close fullscreen gallery"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="gallery__fs-nav-group">
        <button
          type="button"
          class="gallery__fs-btn gallery__fs-btn--nav"
          data-gallery-fs-prev
          aria-label="Previous photo"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </button>

        <span class="gallery__fs-counter" data-gallery-fs-counter>
          1 / {images.length}
        </span>

        <button
          type="button"
          class="gallery__fs-btn gallery__fs-btn--nav"
          data-gallery-fs-next
          aria-label="Next photo"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      </div>
    </div>
  )}
</div>

<script>
  import EmblaCarousel from 'embla-carousel';

  const galleries = document.querySelectorAll<HTMLElement>('[data-gallery]');

  galleries.forEach((galleryRoot) => {
    const mainNode = galleryRoot.querySelector<HTMLElement>('[data-gallery-main]');
    const thumbsNode = galleryRoot.querySelector<HTMLElement>('[data-gallery-thumbs]');
    const mainPrevBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-main-prev]');
    const mainNextBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-main-next]');
    const prevBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-thumbs-prev]');
    const nextBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-thumbs-next]');
    const fsCloseBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-fs-close]');
    const fsPrevBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-fs-prev]');
    const fsNextBtn = galleryRoot.querySelector<HTMLButtonElement>('[data-gallery-fs-next]');
    const fsCounter = galleryRoot.querySelector<HTMLElement>('[data-gallery-fs-counter]');
    const thumbSlides = Array.from(
      galleryRoot.querySelectorAll<HTMLElement>('[data-gallery-thumb-slide]')
    );

    if (!mainNode || !thumbsNode || thumbSlides.length === 0) return;

    let isFullscreen = false;
    let savedScrollY = 0;

    const emblaMain = EmblaCarousel(mainNode, {
      loop: false,
      align: 'start',
      axis: 'y',
      breakpoints: {
        '(max-width: 739px)': { axis: 'x' },
      },
    });

    const emblaThumbs = EmblaCarousel(thumbsNode, {
      align: 'start',
      containScroll: 'trimSnaps',
      dragFree: true,
      axis: 'y',
      breakpoints: {
        '(max-width: 739px)': { axis: 'x' },
      },
    });

    const updateMainNav = () => {
      const canPrev = emblaMain.canScrollPrev();
      const canNext = emblaMain.canScrollNext();
      const isScrollable = canPrev || canNext;

      if (mainPrevBtn && mainNextBtn) {
        if (!isScrollable) {
          mainPrevBtn.hidden = true;
          mainNextBtn.hidden = true;
        } else {
          mainPrevBtn.hidden = false;
          mainNextBtn.hidden = false;
          mainPrevBtn.disabled = !canPrev;
          mainNextBtn.disabled = !canNext;
        }
      }

      if (fsPrevBtn && fsNextBtn) {
        fsPrevBtn.disabled = !canPrev;
        fsNextBtn.disabled = !canNext;
      }

      if (fsCounter) {
        fsCounter.textContent = `${emblaMain.selectedScrollSnap() + 1} / ${thumbSlides.length}`;
      }
    };

    const updateThumbsNav = () => {
      if (!prevBtn || !nextBtn) return;

      const canPrev = emblaThumbs.canScrollPrev();
      const canNext = emblaThumbs.canScrollNext();
      const isScrollable = canPrev || canNext;

      if (!isScrollable) {
        prevBtn.hidden = true;
        nextBtn.hidden = true;
        return;
      }

      prevBtn.hidden = false;
      nextBtn.hidden = false;
      prevBtn.disabled = !canPrev;
      nextBtn.disabled = !canNext;
    };

    const syncSelectedThumb = (jump = false) => {
      const selectedIndex = emblaMain.selectedScrollSnap();
      const maxSnap = Math.max(0, emblaThumbs.scrollSnapList().length - 1);
      const targetSnap = Math.max(0, Math.min(maxSnap, selectedIndex - 2));
      emblaThumbs.scrollTo(targetSnap, jump);

      thumbSlides.forEach((slide, idx) => {
        const isSelected = idx === selectedIndex;
        slide.classList.toggle('gallery__thumb-item--active', isSelected);
        const btn = slide.querySelector('button');
        if (btn) {
          if (isSelected) {
            btn.setAttribute('aria-current', 'true');
          } else {
            btn.removeAttribute('aria-current');
          }
        }
      });

      updateMainNav();
      updateThumbsNav();
    };

    const setFullscreen = (nextState: boolean) => {
      if (nextState === isFullscreen) return;
      if (nextState && window.innerWidth < 740) return;

      const currentIndex = emblaMain.selectedScrollSnap();

      if (nextState) {
        savedScrollY = window.scrollY;
        isFullscreen = true;
        document.documentElement.classList.add('is-gallery-fullscreen');
      } else {
        isFullscreen = false;
        document.documentElement.classList.remove('is-gallery-fullscreen');
        window.scrollTo(0, savedScrollY);
      }

      emblaMain.reInit();
      emblaThumbs.reInit();
      emblaMain.scrollTo(currentIndex, true);
      syncSelectedThumb(true);
    };

    mainNode.addEventListener('click', () => {
      if (window.innerWidth < 740) return;
      if (!isFullscreen) {
        setFullscreen(true);
      }
    });

    if (fsCloseBtn) {
      fsCloseBtn.addEventListener('click', () => {
        setFullscreen(false);
      });
    }

    galleryRoot.addEventListener('click', (event) => {
      if (!isFullscreen) return;
      if (event.target === galleryRoot) {
        setFullscreen(false);
      }
    });

    window.addEventListener('keydown', (event) => {
      if (!isFullscreen) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        setFullscreen(false);
      } else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
        event.preventDefault();
        emblaMain.scrollPrev();
      } else if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
        event.preventDefault();
        emblaMain.scrollNext();
      }
    });

    thumbSlides.forEach((slide, index) => {
      slide.addEventListener('click', () => {
        emblaMain.scrollTo(index);
      });
    });

    if (mainPrevBtn) {
      mainPrevBtn.addEventListener('click', () => {
        emblaMain.scrollPrev();
      });
    }

    if (mainNextBtn) {
      mainNextBtn.addEventListener('click', () => {
        emblaMain.scrollNext();
      });
    }

    if (fsPrevBtn) {
      fsPrevBtn.addEventListener('click', () => {
        emblaMain.scrollPrev();
      });
    }

    if (fsNextBtn) {
      fsNextBtn.addEventListener('click', () => {
        emblaMain.scrollNext();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        const target = Math.max(0, emblaThumbs.selectedScrollSnap() - 4);
        emblaThumbs.scrollTo(target);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const maxSnap = emblaThumbs.scrollSnapList().length - 1;
        const target = Math.min(maxSnap, emblaThumbs.selectedScrollSnap() + 4);
        emblaThumbs.scrollTo(target);
      });
    }

    const thumbsCol = galleryRoot.querySelector<HTMLElement>('[data-gallery-thumbs-col]') || thumbsNode;
    let wheelAccumulator = 0;
    thumbsCol.addEventListener(
      'wheel',
      (event) => {
        if (window.innerWidth < 740) return;

        const canPrev = emblaThumbs.canScrollPrev();
        const canNext = emblaThumbs.canScrollNext();
        if (!canPrev && !canNext) return;

        event.preventDefault();

        if ((event.deltaY < 0 && !canPrev) || (event.deltaY > 0 && !canNext)) {
          wheelAccumulator = 0;
          return;
        }

        wheelAccumulator += event.deltaY;

        const stepThreshold = 40;
        const steps = Math.trunc(wheelAccumulator / stepThreshold);
        if (steps !== 0) {
          wheelAccumulator -= steps * stepThreshold;
          const maxSnap = emblaThumbs.scrollSnapList().length - 1;
          const target = Math.max(
            0,
            Math.min(maxSnap, emblaThumbs.selectedScrollSnap() + steps)
          );
          emblaThumbs.scrollTo(target);
        }
      },
      { passive: false }
    );

    emblaMain.on('init', updateMainNav);
    emblaMain.on('select', () => syncSelectedThumb(false));
    emblaMain.on('reInit', () => syncSelectedThumb(false));

    emblaThumbs.on('init', updateThumbsNav);
    emblaThumbs.on('reInit', updateThumbsNav);
    emblaThumbs.on('select', updateThumbsNav);
    emblaThumbs.on('scroll', updateThumbsNav);

    updateMainNav();
    updateThumbsNav();
  });
</script>
