---
import './QrModal.css';
import HystModal from '../HystModal/HystModal.astro';
import Window from '../Window/Window.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { useTranslations, getLangFromUrl } from '../../i18n/utils';

export interface Props {
  id: string;
  /** Тема оформления */
  messenger: 'telegram' | 'messenger' | 'zalo';
  /** Название мессенджера для подписей */
  name: string;
  currentLang?: SupportedLanguage;
  qrImage: string;
  /** Текст ссылки: адрес без https://. По умолчанию «Открыть {name}» */
  username?: string;
  link: string;
  /** Закодированный номер Zalo: ссылку и текст подставит utils/contacts.ts */
  zaloCode?: string;
  logoSrc?: string;
}

const {
  id,
  messenger,
  name,
  currentLang = getLangFromUrl(Astro.url),
  qrImage,
  username,
  link,
  zaloCode,
  logoSrc = '/logo.webp',
} = Astro.props;

const t = useTranslations(currentLang);
---

<HystModal id={id} label={`${t('catalog.inquiry.order_via')} ${name}`}>
  <Window>
    <div class:list={['qr-modal', `qr-modal--${messenger}`]}>
      {/* Дублирует ссылку под QR: с клавиатуры и для скринридера достаточно той */}
      <a
        class="qr-modal__logo"
        href={link}
        data-zalo={zaloCode}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="-1"
        aria-hidden="true"
      >
        <img
          class="qr-modal__emblem"
          src={logoSrc}
          width="108"
          height="108"
          alt=""
        />
      </a>
      <img
        class="qr-modal__image"
        src={qrImage}
        alt={t('qr_modal.qr_alt').replace('{name}', name)}
        style={`mask-image: url(${qrImage});`}
      />
      <div class="qr-modal__or-hint">
        {t('qr_modal.hint')}
      </div>
      <a
        class="qr-modal__username"
        href={link}
        data-zalo={zaloCode}
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="qr-modal__link-text" data-zalo-text={zaloCode && ''}>{username ?? t('qr_modal.open').replace('{name}', name)}</div>
        {messenger === 'telegram' && <div class="qr-modal__note">{t('qr_modal.telegram_note')}</div>}
      </a>
    </div>
  </Window>
</HystModal>
