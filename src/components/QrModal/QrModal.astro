---
import './QrModal.css';
import beachSvg from './beach-fixed-edges.svg?url';
import zaloPatternPng from './zalo-pattern.png?url';
import HystModal from '../HystModal/HystModal.astro';
import Window from '../Window/Window.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { useTranslations, getLangFromUrl } from '../../i18n/utils';

export interface Props {
  id: string;
  name: string;
  currentLang?: SupportedLanguage;
  messenger?: 'telegram' | 'messenger' | 'whatsapp' | 'zalo' | string;
  qrImage: string;
  username: string;
  link: string;
  logoSrc?: string;
  usernameFontSize?: number;
}

const {
  id,
  name,
  currentLang: propLang,
  messenger,
  qrImage,
  username,
  link,
  logoSrc = '/logo_icon.png',
  usernameFontSize = 22,
} = Astro.props;

const currentLang = propLang ?? getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const messengerKey = messenger || id.replace(/^qr-modal-/, '').replace(/^modal-qr-/, '');
const displayUsername = username.startsWith('@') ? username.slice(1) : username;
const isTelegram = messengerKey === 'telegram';
const isZalo = messengerKey === 'zalo';
---

{isTelegram && (
  <link rel="preload" href={beachSvg} as="image" type="image/svg+xml" />
)}
{isZalo && (
  <link rel="preload" href={zaloPatternPng} as="image" type="image/png" />
)}

<HystModal id={id}>
  <Window>
    <div class:list={['qr-modal', `qr-modal--${messengerKey}`, id && `qr-modal--${id}`, isTelegram && 'qr-modal-telegram']}>
      <img
        class="qr-modal__logo qr-modal-telegram__logo"
        src={logoSrc}
        width="108"
        height="108"
        alt="BunnyBearBeads Logo"
      />
      <img
        class="qr-modal__image qr-modal-telegram__image"
        src={qrImage}
        alt={`QR code for ${name}`}
        style={`-webkit-mask-image: url(${qrImage}); mask-image: url(${qrImage});`}
      />
      <p class="qr-modal__hint">{t('qr_modal.or_link')}</p>
      <a
        class="qr-modal__username qr-modal-telegram__username"
        style={`font-size: ${usernameFontSize}px;`}
        href={link}
        target="_blank"
        rel="noopener noreferrer"
      >
        @<span class="qr-modal__hover qr-modal-telegram__hover">{displayUsername}</span>
      </a>
    </div>
  </Window>
</HystModal>
