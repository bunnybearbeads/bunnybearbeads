---
import './QrModal.css';
import HystModal from '../HystModal/HystModal.astro';
import Window from '../Window/Window.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { useTranslations, getLangFromUrl } from '../../i18n/utils';

export interface Props {
  id: string;
  /** Тема оформления */
  messenger: 'telegram' | 'messenger' | 'zalo';
  /** Название мессенджера для подписей */
  name: string;
  currentLang?: SupportedLanguage;
  qrImage: string;
  /** Текст ссылки: адрес без https://. По умолчанию «Открыть {name}» */
  username?: string;
  link: string;
  /** Закодированный номер Zalo: ссылку и текст подставит utils/contacts.ts */
  zaloCode?: string;
  logoSrc?: string;
}

const {
  id,
  messenger,
  name,
  currentLang = getLangFromUrl(Astro.url),
  qrImage,
  username,
  link,
  zaloCode,
  logoSrc = '/logo.webp',
} = Astro.props;

const t = useTranslations(currentLang);
---

<HystModal id={id} label={`${t('catalog.inquiry.order_via')} ${name}`}>
  <Window>
    <div class:list={['qr-modal', `qr-modal--${messenger}`]}>
      <img
        class="qr-modal__logo"
        src={logoSrc}
        width="108"
        height="108"
        alt={t('site.logo_alt')}
      />
      <img
        class="qr-modal__image"
        src={qrImage}
        alt={t('qr_modal.qr_alt').replace('{name}', name)}
        style={`-webkit-mask-image: url(${qrImage}); mask-image: url(${qrImage});`}
      />
      <p class="qr-modal__hint">{t('qr_modal.hint')}</p>
      <a
        class="qr-modal__username"
        href={link}
        data-zalo={zaloCode}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="qr-modal__username-text" data-zalo-text={zaloCode && ''}>{username ?? t('qr_modal.open').replace('{name}', name)}</span>
        {messenger === 'telegram' && <span class="qr-modal__note">{t('qr_modal.telegram_note')}</span>}
      </a>
    </div>
  </Window>
</HystModal>
