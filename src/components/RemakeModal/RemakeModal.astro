---
import HystModal from '../HystModal/HystModal.astro';
import Window from '../Window/Window.astro';
import Availability from '../Availability/Availability.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { siteSettings } from '../../config/siteSettings';

interface Props {
  product: any;
  currentLang: SupportedLanguage;
  categoryId?: string;
  remakeDays?: string;
}

const {
  product,
  currentLang,
  categoryId = 'bracelets',
  remakeDays = siteSettings.fulfillment.remakeDays,
} = Astro.props;

const t = useTranslations(currentLang);
const remakeUnit = {
  ru: 'дня',
  en: 'days',
  vi: 'ngày',
}[currentLang] || 'days';

const remakeContent = t('catalog.modal.remake_content')
  .replace('{remakeDays}', remakeDays)
  .replace('{remakeUnit}', remakeUnit);

const noteHtml = t('catalog.modal.remake_note');
---

<HystModal id="modal-remake">
  <Window>
    <Availability
      title={t('catalog.modal.remake_title')}
      titleId="modal-remake-title"
      contentHtml={remakeContent}
      action={{
        href: siteSettings.contacts.telegramUrl,
        label: t('catalog.modal.remake_tg_button'),
      }}
      noteHtml={noteHtml}
    />
  </Window>
</HystModal>
