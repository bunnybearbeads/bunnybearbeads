---
import HystModal from '../HystModal/HystModal.astro';
import Window from '../Window/Window.astro';
import Availability from '../Availability/Availability.astro';
import { type SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { siteSettings } from '../../config/siteSettings';

interface Props {
  product: { title: string };
  currentLang: SupportedLanguage;
  remakeDays?: string;
}

const {
  product,
  currentLang,
  remakeDays = siteSettings.fulfillment.remakeDays,
} = Astro.props;

const t = useTranslations(currentLang);
const remakeUnit = {
  en: 'days',
  ru: 'дня',
  vi: 'ngày',
}[currentLang] || 'days';

const remakeContent = t('catalog.modal.remake_content')
  .replace('{remakeDays}', remakeDays)
  .replace('{remakeUnit}', remakeUnit);

const noteHtml = t('catalog.modal.remake_note');
---

<HystModal id="modal-remake" labelledby="modal-remake-title">
  <Window title={t('catalog.modal.remake_title')} titleId="modal-remake-title">
    <Availability
      contentHtml={remakeContent}
      inquiry={{
        currentLang,
        productTitle: product.title,
      }}
      noteHtml={noteHtml}
    />
  </Window>
</HystModal>
