---
import HystModal from '../HystModal/HystModal.astro';
import Window from '../Window/Window.astro';
import Wysiwyg from '../Wysiwyg/Wysiwyg.astro';
import Button from '../Button/Button.astro';
import Icon from '../Icon/Icon.astro';
import '../Checkup/Checkup.css';
import { type SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { siteSettings } from '../../config/siteSettings';

interface Props {
  product: any;
  currentLang: SupportedLanguage;
  categoryId?: string;
  remakeDays?: string;
}

const {
  product,
  currentLang,
  categoryId = 'bracelets',
  remakeDays = siteSettings.fulfillment.remakeDays,
} = Astro.props;

const t = useTranslations(currentLang);
const isResizableCategory = categoryId === 'bracelets' || categoryId === 'rings';

const remakeUnit = {
  ru: 'дня',
  en: 'days',
  vi: 'ngày',
}[currentLang] || 'days';

const remakeContent = t('catalog.modal.remake_content')
  .replace('{remakeDays}', remakeDays)
  .replace('{remakeUnit}', remakeUnit);
---

<HystModal id="modal-remake">
  <Window>
    <div class="checkup">
      <h3 class="checkup__title" id="modal-remake-title">
        {t('catalog.modal.remake_title')}
      </h3>

      <Wysiwyg
        class="checkup__description"
        halved
        set:html={remakeContent}
      />

      <div class="checkup__location checkup__location--remake">
        <Button
          href={siteSettings.contacts.telegramUrl}
          target="_blank"
        >
          <span>{t('catalog.modal.remake_tg_button')}</span>
          <Icon name="arrow_outward" />
        </Button>
      </div>

      <Wysiwyg class="checkup__description" halved>
        <p set:html={isResizableCategory ? t('catalog.modal.remake_note_resizable') : t('catalog.modal.remake_note_standard')} />
      </Wysiwyg>
    </div>
  </Window>
</HystModal>
