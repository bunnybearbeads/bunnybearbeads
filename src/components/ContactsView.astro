---
import Accent from './Accent/Accent.astro';
import { type SupportedLanguage } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="container">
  <header class="page-header">
    <div class="welcome-badge">
      <span>💌</span> {t('nav.contacts')}
    </div>
    <h1 class="page-title">
      {t('contacts.title')}
    </h1>
    <p class="page-subtitle">
      {t('contacts.subtitle')}
    </p>
  </header>

  <div class="contacts-grid">
    <!-- Contact Info & Direct Links -->
    <div class="contact-channels">
      <div class="content-card" style="margin-bottom: 24px;">
        <h2>{t('contacts.intro_heading')}</h2>
        <p>{t('contacts.intro_text')}</p>
      </div>

      <div class="contact-channel-item">
        <span class="channel-icon">📍</span>
        <div class="channel-meta">
          <strong>{t('contacts.location_label')}</strong>
          <span>{t('contacts.location_value')}</span>
        </div>
      </div>

      <a href="mailto:hello@bunnybearbeads.com" class="contact-channel-item">
        <span class="channel-icon">✉️</span>
        <div class="channel-meta">
          <strong>{t('contacts.email_label')}</strong>
          <span>{t('contacts.email_value')}</span>
        </div>
      </a>

      <a href="https://t.me/bunnybearbeads" target="_blank" rel="noopener noreferrer" class="contact-channel-item">
        <span class="channel-icon">✈️</span>
        <div class="channel-meta">
          <strong>{t('contacts.telegram_label')}</strong>
          <span>{t('contacts.telegram_value')}</span>
        </div>
      </a>

      <a href="https://instagram.com/bunnybearbeads" target="_blank" rel="noopener noreferrer" class="contact-channel-item">
        <span class="channel-icon">📸</span>
        <div class="channel-meta">
          <strong>{t('contacts.instagram_label')}</strong>
          <span>{t('contacts.instagram_value')}</span>
        </div>
      </a>
    </div>

    <!-- Inquiry / Order Form -->
    <div class="content-card" style="margin-bottom: 0;">
      <h2>Leave a <Accent>Message</Accent></h2>
      <form class="contact-form" onsubmit="event.preventDefault(); alert('Message sent! Thank you.');">
        <div class="form-group">
          <label for="contact-name">{t('contacts.form_name')}</label>
          <input
            type="text"
            id="contact-name"
            class="form-input"
            placeholder="Jane Doe"
            required
          />
        </div>

        <div class="form-group">
          <label for="contact-email">{t('contacts.form_email')}</label>
          <input
            type="text"
            id="contact-email"
            class="form-input"
            placeholder="jane@example.com or @telegram_user"
            required
          />
        </div>

        <div class="form-group">
          <label for="contact-message">{t('contacts.form_message')}</label>
          <textarea
            id="contact-message"
            class="form-textarea"
            rows="5"
            placeholder="I would love a custom choker in emerald and gold..."
            required
          ></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="margin-top: 10px;">
          <span>✨</span> {t('contacts.form_submit')}
        </button>
      </form>
    </div>
  </div>
</div>
