---
import { type SupportedLanguage } from '../../i18n/ui';
import { PARTNER_LOCATIONS } from '../../config/locations';
import HystModal from '../HystModal/HystModal.astro';
import Window from '../Window/Window.astro';
import Checkup from '../Checkup/Checkup.astro';

interface Props {
  product: any;
  currentLang: SupportedLanguage;
}

const { product, currentLang } = Astro.props;
---

{PARTNER_LOCATIONS.map((loc) => (
  <HystModal id={loc.modalId}>
    <Window>
      <Checkup
        loc={loc}
        product={product}
        currentLang={currentLang}
      />
    </Window>
  </HystModal>
))}
