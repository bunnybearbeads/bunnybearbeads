---
import './ProductDetail.css';
import '../Icon/Icon.css';
import { type SupportedLanguage } from '../../i18n/ui';
import { getLocalizedUrl, useTranslations, formatAuditRelativeDate } from '../../i18n/utils';
import { siteSettings } from '../../config/siteSettings';
import { LOCATIONS, getLocation } from '../../config/locations';
import RemakePill from './RemakePill.astro';
import PartnerModals from './PartnerModals.astro';
import DottedTitle from '../DottedTitle/DottedTitle.astro';

interface Props {
  product: any;
  productRaw: any;
  currentLang: SupportedLanguage;
}

const { product, productRaw, currentLang } = Astro.props;
const t = useTranslations(currentLang);
const categoryId = productRaw.data.categoryId || 'bracelets';

const rawStock = productRaw.data.stockLocations || [];
const stockLocations = rawStock.map((sl: any) => ({
  ...sl,
  meta: getLocation(sl.locationId) || LOCATIONS.dalat,
}));

const dalatOffline = stockLocations.find((l: any) => l.meta.id === 'dalat');
const otherOffline = stockLocations.filter((l: any) => l.meta.type === 'partner');
const hasOnline = stockLocations.some((l: any) => l.meta.type === 'online') || stockLocations.length === 0;

const isDalatInStock = dalatOffline ? (dalatOffline.quantity !== undefined && dalatOffline.quantity > 0) : false;
const dalatLoc = dalatOffline || { locationId: 'dalat', quantity: 0, meta: LOCATIONS.dalat };
---

<div class="product-info-panel">
  <nav class="product-top-meta" aria-label="Breadcrumb">
    <a href={getLocalizedUrl('/catalog', currentLang)} class="product-breadcrumb-link">
      {t('catalog.breadcrumb')}
    </a>
    <span class="product-top-sep" aria-hidden="true">→</span>
    <a
      href={`${getLocalizedUrl('/catalog', currentLang)}?category=${categoryId}`}
      class="product-breadcrumb-link product-category"
    >
      {product.category}
    </a>
  </nav>
  <h1>{product.title}</h1>

  {product.description && (
    <p class="product-description-text">
      {product.description}
    </p>
  )}

  <div class="product-price-large">
    {Number(product.price).toLocaleString('vi-VN')} {product.currency || 'VND'}
  </div>

  <!-- Where to Buy section -->
  <div class="where-to-buy-section">
    <DottedTitle as="h2">{t('catalog.where_to_buy')}</DottedTitle>

    <div
      class="where-to-buy-content"
      data-schedule-open={siteSettings.studio.openHour}
      data-schedule-cutoff={siteSettings.studio.cutoffHour}
      data-schedule-close={siteSettings.studio.closeHour}
    >
      {/* Delivery Options */}
      {hasOnline && (
        <div class="delivery-block">
          <div class="buy-option-card">
            <div class="buy-option-main">
              <div class="buy-option-icon">📦</div>
              <div class="buy-option-content">
                <div class="buy-option-title">{t('catalog.delivery_vn_title')}</div>
                <span class="delivery-subnote">
                  <span class="subnote-item">{t('catalog.free')}</span>
                  <span class="subnote-item" set:html={isDalatInStock ? t('catalog.delivery_from_dalat') : t('catalog.delivery_from_dalat_remake')} />
                  <span class="subnote-item">
                    <span class="icon">payments</span>
                    <span class="icon">qr_code</span>
                    {t('catalog.pay_on_receipt')}
                  </span>
                </span>
                {isDalatInStock ? (
                  <span class="stock-quantity-pill">
                    <strong>{dalatLoc.quantity} {t('catalog.pcs')}</strong>
                    <span class="stock-pill-suffix">{t('catalog.ready_to_ship')}</span>
                  </span>
                ) : (
                  <RemakePill currentLang={currentLang} />
                )}
              </div>
            </div>
          </div>

          <div class="buy-option-card">
            <div class="buy-option-main">
              <div class="buy-option-icon">🛵</div>
              <div class="buy-option-content">
                <div class="buy-option-title">{t('catalog.delivery_dalat_title')}</div>
                <span class="delivery-subnote">
                  <span class="subnote-item">{t('catalog.free')}</span>
                  {isDalatInStock ? (
                    <span
                      class="subnote-item dalat-dynamic-cutoff-text"
                      data-text-today={t('catalog.delivery_dalat_sub_today')}
                      data-text-morning={t('catalog.delivery_dalat_sub_morning')}
                      data-text-tomorrow={t('catalog.delivery_dalat_sub_tomorrow')}
                      set:html={t('catalog.delivery_dalat_sub_today')}
                    />
                  ) : (
                    <span class="subnote-item" set:html={t('catalog.delivery_dalat_sub_remake')} />
                  )}
                  <span class="subnote-item">
                    <span class="icon">payments</span>
                    <span class="icon">qr_code</span>
                    {t('catalog.pay_on_receipt')}
                  </span>
                </span>
                {isDalatInStock ? (
                  <span class="stock-quantity-pill">
                    <strong>{dalatLoc.quantity} {t('catalog.pcs')}</strong>
                    <span class="stock-pill-suffix">{t('catalog.ready_to_ship')}</span>
                  </span>
                ) : (
                  <RemakePill currentLang={currentLang} />
                )}
              </div>
            </div>
          </div>
        </div>
      )}

      {/* In-Person Showcases & Pickup */}
      <div class="showcases-block">
        <DottedTitle as="h2">{t('catalog.showcase_title')}</DottedTitle>

        <div class="buy-options-list">
          {/* Da Lat Studio */}
          <div class="buy-option-card">
            <div class="buy-option-main">
              <div class="buy-option-icon">🏠</div>
              <div class="buy-option-content">
                <div class="buy-option-title">
                  <strong>{t(dalatLoc.meta.cityKey)}{dalatLoc.meta.districtKey ? `, ${t(dalatLoc.meta.districtKey)}` : ''}</strong> — {t('geo.pickup_at_workshop_suffix')}
                </div>
                <span class="delivery-subnote">
                  {isDalatInStock ? (
                    <span
                      class="subnote-item dalat-dynamic-cutoff-text"
                      data-text-today={t('catalog.pickup_dalat_sub_today')}
                      data-text-morning={t('catalog.pickup_dalat_sub_morning')}
                      data-text-tomorrow={t('catalog.pickup_dalat_sub_tomorrow')}
                      set:html={t('catalog.pickup_dalat_sub_today')}
                    />
                  ) : (
                    <span class="subnote-item" set:html={t('catalog.pickup_dalat_sub_remake')} />
                  )}
                  <span class="subnote-item">
                    <span class="icon">payments</span>
                    <span class="icon">qr_code</span>
                    {t('catalog.pay_on_pickup')}
                  </span>
                </span>
                {isDalatInStock ? (
                  <span class="stock-quantity-pill">
                    <strong>{dalatLoc.quantity} {t('catalog.pcs')}</strong>
                    <span class="stock-pill-suffix">{t('catalog.in_stock_suffix')}</span>
                  </span>
                ) : (
                  <RemakePill currentLang={currentLang} />
                )}
              </div>
            </div>
          </div>

          {/* Partner Shops */}
          {otherOffline.map((loc: any) => {
            const isOfflineCheckup = Boolean(loc.lastCheckedAt);
            const modalTarget = isOfflineCheckup ? `#${loc.meta.modalId}` : undefined;

            return (
              <div class="buy-option-card">
                <div class="buy-option-main">
                  <div class="buy-option-icon">📍</div>
                  <div class="buy-option-content">
                    <div class="buy-option-title">
                      <strong>{t(loc.meta.cityKey)}{loc.meta.districtKey ? `, ${t(loc.meta.districtKey)}` : ''}</strong> — {t('catalog.on_showcase_at')} <strong>{loc.meta.shop}</strong>
                    </div>
                    <span class="delivery-subnote">
                      <span class="subnote-item" set:html={t('catalog.shop_working_hours')} />
                      <span class="subnote-item">
                        <span class="icon">payments</span>
                        <span class="icon">qr_code</span>
                        <span class="icon">credit_card</span>
                        {t('catalog.pay_at_checkout')}
                      </span>
                    </span>
                    {loc.quantity !== undefined && (
                      loc.lastCheckedAt ? (
                        <span
                          class="stock-quantity-pill stock-quantity-pill--clickable"
                          data-hystmodal={modalTarget}
                          role={modalTarget ? 'button' : undefined}
                          tabindex={modalTarget ? 0 : undefined}
                          title={modalTarget ? t('catalog.weekly_audit_hint') : undefined}
                        >
                          <strong>{loc.quantity} {t('catalog.pcs')}</strong>
                          <span class="audit-sep">·</span>
                          <span class="audit-date" data-audit-date={loc.lastCheckedAt}>{formatAuditRelativeDate(loc.lastCheckedAt, currentLang)}</span>
                          <span class="pill-info-icon" aria-hidden="true">ℹ️</span>
                        </span>
                      ) : (
                        <span class="stock-quantity-pill">
                          <strong>{loc.quantity} {t('catalog.pcs')}</strong>
                          <span class="stock-pill-suffix">{t('catalog.in_stock_suffix')}</span>
                        </span>
                      )
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <!-- Crafter's Note Section -->
  {product.crafterNote && (
    <div class="crafter-note-section">
      <DottedTitle>{t('catalog.crafter_note_title')}</DottedTitle>
      <div class="crafter-note-body" set:html={product.crafterNote} />
    </div>
  )}

  <div class="cta-buttons product-cta-buttons">
    <a
      href="https://t.me/bunnybearbeads"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary btn-lg"
    >
      <span>✈️</span> {t('catalog.order_piece')} (Telegram)
    </a>
  </div>
</div>

<PartnerModals
  product={product}
  currentLang={currentLang}
  stockLocations={rawStock}
/>

<script src="./productDetail.client.ts"></script>
