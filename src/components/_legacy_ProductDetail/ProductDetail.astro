---
/**
 * Шапка варианта товара: хлебные крошки, название, описание, цена, кнопки заказа.
 * Рендерится отдельно для каждого варианта. Наличие общее для всех вариантов —
 * см. ProductAvailability.astro. Обёртку .product-info-panel даёт Product.astro.
 */
import './ProductDetail.css';
import '../Icon/Icon.css';
import { type SupportedLanguage } from '../../i18n/ui';
import { getLocalizedUrl, useTranslations } from '../../i18n/utils';
import { categoryKey } from '../../utils/products';
import Inquiry from '../Inquiry/Inquiry.astro';
import Wysiwyg from '../Wysiwyg/Wysiwyg.astro';

interface Props {
  product: any;
  productRaw: any;
  currentLang: SupportedLanguage;
  /** Рендерить QR-модалки мессенджеров. На странице с вариантами — только у первого */
  withModals?: boolean;
}

const { product, productRaw, currentLang, withModals = true } = Astro.props;
const t = useTranslations(currentLang);
const categoryId = productRaw.data.categoryId || 'bracelets';
---

<nav class="product-top-meta" aria-label="Breadcrumb">
  <a href={getLocalizedUrl('/catalog', currentLang)} class="product-breadcrumb-link">
    {t('catalog.breadcrumb')}
  </a>
  <span class="product-top-sep" aria-hidden="true">→</span>
  <a
    href={`${getLocalizedUrl('/catalog', currentLang)}?category=${categoryId}`}
    class="product-breadcrumb-link product-category"
  >
    {t(categoryKey(categoryId))}
  </a>
</nav>
<h1>{product.title}</h1>

{product.description && (
  <div class="product-description-text">
    <Wysiwyg>
      {product.description}
    </Wysiwyg>
  </div>
)}

<div class="product-price-large">
  {Number(product.price).toLocaleString('vi-VN')} {product.currency || 'VND'}
</div>

<div class="cta-buttons product-cta-buttons">
  <Inquiry
      currentLang={currentLang}
      productTitle={product.title}
      withModals={withModals}
  />
</div>
