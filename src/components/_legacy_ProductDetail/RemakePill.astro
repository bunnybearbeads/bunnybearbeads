---
import { type SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { siteSettings } from '../../config/siteSettings';

interface Props {
  currentLang: SupportedLanguage;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
const remakeDays = siteSettings.fulfillment.remakeDays;
---

{t('catalog.remake_pill_label')}
<span class="option__stock option__stock--dotted">
  {currentLang === 'ru' && (
    <>
      Повтор <span class="remake-prep-hide">за </span><span class="remake-time">{remakeDays}&nbsp;дня</span>
    </>
  )}
  {currentLang === 'en' && (
    <>
      Remake <span class="remake-prep-hide">in </span><span class="remake-time">{remakeDays}&nbsp;days</span>
    </>
  )}
  {currentLang === 'vi' && (
    <>
      Nhận làm <span class="remake-prep-hide">trong </span><span class="remake-time">{remakeDays}&nbsp;ngày</span>
    </>
  )}
</span>
