---
/**
 * Секция «Наличие» товара.
 *
 * - Мастерская в Далате показывается всегда: если готовых нет — ремейк. Он есть всегда, даже если штуки
 *   лежат у партнёров: все заказы и доставка по Вьетнаму — из Далата, партнёры ничего не отправляют.
 *   Доставка, курьер и самовывоз из мастерской доступны всегда.
 * - Под количеством — комментарий: к штукам в точке или, если в мастерской пусто, к ремейку.
 * - Витрины партнёров — только если там лежит хотя бы одна штука.
 */
import './ProductDetail.css';
import './Option.css';
import '../Icon/Icon.css';
import { type SupportedLanguage } from '../../i18n/ui';
import {
  useTranslations,
  localize,
  formatAuditRelativeDate,
  formatStudioStockQty,
  formatShowcaseStockQty,
} from '../../i18n/utils';
import { siteSettings } from '../../config/siteSettings';
import { LOCATIONS, PARTNER_LOCATIONS, type LocationId } from '../../config/locations';
import StockNote from './StockNote.astro';
import Icon from '../Icon/Icon.astro';
import Link from '../Link/Link.astro';
import DottedTitle from '../DottedTitle/DottedTitle.astro';
import { getLocationQty, type Remake, type Stock } from '../../utils/products';

interface Props {
  stock: Stock;
  /** Есть, только когда в Далате штук нет */
  remake?: Remake;
  /** Название товара — для alt у фото */
  title: string;
  currentLang: SupportedLanguage;
}

const { stock, remake, title, currentLang } = Astro.props;
const t = useTranslations(currentLang);

interface NoteImage {
  src: string;
  alt: string;
}

interface NoteData {
  html?: string;
  images: NoteImage[];
}

function normalizeImages(rawImages: Stock[number]['commentImages'], fallbackTitle: string): NoteImage[] {
  return rawImages.map((img, idx) => {
    if (typeof img === 'string') return { src: img, alt: `${fallbackTitle} — ${idx + 1}` };
    const alt = img.alt
      ? typeof img.alt === 'string'
        ? img.alt
        : localize(img.alt, currentLang)
      : `${fallbackTitle} — ${idx + 1}`;
    return { src: img.src, alt };
  });
}

/** Комментарий к штукам в точке, если он есть */
function noteAt(locationId: LocationId): NoteData | undefined {
  const entry = stock.find((s) => s.locationId === locationId);
  if (!entry || (!entry.note && entry.commentImages.length === 0)) return undefined;
  const meta = LOCATIONS[locationId];
  const placeLabel = meta.shop || (meta.cityKey ? t(meta.cityKey) : '');
  return {
    html: entry.note ? localize(entry.note, currentLang) : undefined,
    images: normalizeImages(entry.commentImages, `${title} (${placeLabel})`),
  };
}

// Мастерская
const studioQty = getLocationQty(stock, 'dalat');
const isDalatInStock = studioQty > 0;
const studioStockBadge = formatStudioStockQty(studioQty || 1, currentLang);
const studioNote = isDalatInStock ? noteAt('dalat') : remakeNote();

/** Комментарий к ремейку: как и к точке — текст и фото */
function remakeNote(): NoteData | undefined {
  if (!remake || (!remake.note && remake.commentImages.length === 0)) return undefined;
  return {
    html: remake.note ? localize(remake.note, currentLang) : undefined,
    images: normalizeImages(remake.commentImages, `${title} (${t('catalog.studio_card_title')})`),
  };
}


// Витрины партнёров
let runningReadyCount = studioQty;
const partnerCards = PARTNER_LOCATIONS.flatMap((meta) => {
  const qty = getLocationQty(stock, meta.id);
  if (qty === 0) return [];
  const badgeText = formatShowcaseStockQty(qty, runningReadyCount > 0, currentLang);
  runningReadyCount += qty;
  const lastCheckedAt = meta.lastCheckedAt || siteSettings.partnerShops.lastCheckedAt;
  return [{
    meta,
    badgeText,
    lastCheckedAt,
    isOfflineCheckup: Boolean(lastCheckedAt),
    note: noteAt(meta.id),
  }];
});

const remakeDays = siteSettings.fulfillment.remakeDays;
const remakeText = {
  en: { action: 'Remake', prep: 'in', unit: 'days' },
  ru: { action: 'Повтор', prep: 'за', unit: 'дня' },
  vi: { action: 'Nhận làm', prep: 'trong', unit: 'ngày' },
}[currentLang];
---

<div class="product__stock-heading">
  <DottedTitle>{t('catalog.availability_title')}</DottedTitle>
</div>

<div class="where-to-buy-section">
  <div
    class="where-to-buy-content"
    data-schedule-open={siteSettings.studio.openHour}
    data-schedule-cutoff={siteSettings.studio.cutoffHour}
    data-schedule-close={siteSettings.studio.closeHour}
  >
    {/* Мастерская в Далате: готовые экземпляры или повтор + способы получения */}
    <div class="option">
      <div class="option__content">
        <div class="option__head">
          <div class="option__main-emoji" aria-hidden="true">🏠</div>
          <div class="option__title">
            <strong class="option__bold">{t('catalog.studio_card_title')}</strong>
          </div>
        </div>

        {isDalatInStock ? (
          <div class="option__quantity">
            {studioStockBadge.qtyText}{' '}<span class="option__stock">{studioStockBadge.suffix}</span>
          </div>
        ) : (
          <button
            type="button"
            class="option__quantity option__quantity--out-of-stock option__quantity--clickable"
            data-hystmodal="#modal-remake"
            title={t('catalog.remake_hint')}
          >
            {t('catalog.studio_remake_label')}{' '}<span class="option__stock option__stock--dotted">
              {remakeText.action} <span class="option__preposition">{remakeText.prep} </span>{remakeDays}&nbsp;{remakeText.unit}
            </span>
            <Icon class="option__help-icon" name="help" />
          </button>
        )}

        {studioNote && (
          <div class="option__details">
            <StockNote html={studioNote.html} images={studioNote.images} currentLang={currentLang} />
          </div>
        )}
      </div>

      <div class="option__fulfillment">
        <ul class="option__list" role="list">
          <li class="option__item">
            <div class="option__fulfillment-head">
              <span class="option__fulfillment-emoji" aria-hidden="true">📦</span>
              <strong class="option__channel">{t('catalog.delivery_vn_title')}</strong>
            </div>
            <div class="option__info">
              <span class="option__note">{t('catalog.free')}</span>
              <span
                class="option__note"
                set:html={isDalatInStock ? t('catalog.delivery_from_dalat') : t('catalog.delivery_from_dalat_remake')}
              />
              <span class="option__note">
                <Icon name="payments" />
                <Icon name="qr_code" />
                {t('catalog.pay_on_receipt')}
              </span>
            </div>
          </li>

          <li class="option__item">
            <div class="option__fulfillment-head">
              <span class="option__fulfillment-emoji" aria-hidden="true">🛵</span>
              <strong class="option__channel">{t('catalog.delivery_dalat_title')}</strong>
            </div>
            <div class="option__info">
              <span class="option__note">{t('catalog.free')}</span>
              {isDalatInStock ? (
                <span
                  class="option__note dalat-dynamic-cutoff-text"
                  data-text-today={t('catalog.delivery_dalat_sub_today')}
                  data-text-morning={t('catalog.delivery_dalat_sub_morning')}
                  data-text-tomorrow={t('catalog.delivery_dalat_sub_tomorrow')}
                  set:html={t('catalog.delivery_dalat_sub_today')}
                />
              ) : (
                <span class="option__note" set:html={t('catalog.delivery_dalat_sub_remake')} />
              )}
              <span class="option__note">
                <Icon name="payments" />
                <Icon name="qr_code" />
                {t('catalog.pay_on_receipt')}
              </span>
            </div>
          </li>

          <li class="option__item">
            <div class="option__fulfillment-head">
              <span class="option__fulfillment-emoji" aria-hidden="true">🛍️</span>
              <strong class="option__channel">{t('catalog.pickup_studio_title')}</strong>
            </div>
            <div class="option__info">
              {isDalatInStock ? (
                <span
                  class="option__note dalat-dynamic-cutoff-text"
                  data-text-today={t('catalog.pickup_dalat_sub_today')}
                  data-text-morning={t('catalog.pickup_dalat_sub_morning')}
                  data-text-tomorrow={t('catalog.pickup_dalat_sub_tomorrow')}
                  set:html={t('catalog.pickup_dalat_sub_today')}
                />
              ) : (
                <span class="option__note" set:html={t('catalog.pickup_dalat_sub_remake')} />
              )}
              <span class="option__note">
                <Icon name="payments" />
                <Icon name="qr_code" />
                {t('catalog.pay_on_pickup')}
              </span>
            </div>
          </li>
        </ul>
      </div>

    </div>

    {/* Витрины партнёров */}
    {partnerCards.map((card) => (
      <div class="option">
        <div class="option__content">
          <div class="option__head">
            <div class="option__main-emoji" aria-hidden="true">📍</div>
            <div class="option__title">
              <strong class="option__bold">{t(card.meta.cityKey!)}{card.meta.districtKey ? `, ${t(card.meta.districtKey)}` : ''}</strong>&nbsp;— {t('catalog.on_showcase_at')}&nbsp;{card.meta.mapsUrl ? (
                <Link
                  href={card.meta.mapsUrl}
                  target="_blank"
                  accentUnderline
                  title={card.meta.modalMapsKey ? t(card.meta.modalMapsKey) : undefined}
                >
                  <strong class="option__bold">{card.meta.shop}</strong>
                </Link>
              ) : (
                <strong class="option__bold">{card.meta.shop}</strong>
              )}
            </div>
          </div>

          <div class="option__info">
            <span class="option__note" set:html={t('catalog.shop_working_hours')} />
            <span class="option__note">
              <Icon name="payments" />
              <Icon name="qr_code" />
              <Icon name="credit_card" />
              {t('catalog.pay_in_store_checkout')}
            </span>
          </div>

          {card.isOfflineCheckup ? (
            <button
              type="button"
              class="option__quantity option__quantity--clickable"
              data-hystmodal={`#${card.meta.modalId}`}
              title={t('catalog.weekly_audit_hint')}
            >
              {card.badgeText}{' '}<span
                class="option__stock option__stock--dotted"
                data-audit-date={card.lastCheckedAt}
                set:html={formatAuditRelativeDate(card.lastCheckedAt, currentLang)}
              />
              <Icon class="option__help-icon" name="help" />
            </button>
          ) : (
            <div class="option__quantity">{card.badgeText}</div>
          )}

          {card.note && (
            <div class="option__details">
              <StockNote html={card.note.html} images={card.note.images} currentLang={currentLang} />
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<script src="./productDetail.client.ts"></script>
