---
import './Header.css';
import Accent from '../Accent/Accent.astro';
import { languages, type SupportedLanguage } from '../../i18n/ui';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

interface Props {
  currentLang?: SupportedLanguage;
}

const url = Astro.url;
const currentLang = Astro.props.currentLang || getLangFromUrl(url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

// Extract clean pathname without current locale
const pathname = url.pathname;
let currentCleanPath = pathname;
if (currentCleanPath.startsWith('/ru/') || currentCleanPath === '/ru') {
  currentCleanPath = currentCleanPath.replace(/^\/ru/, '') || '/';
} else if (currentCleanPath.startsWith('/vi/') || currentCleanPath === '/vi') {
  currentCleanPath = currentCleanPath.replace(/^\/vi/, '') || '/';
}
if (!currentCleanPath.startsWith('/')) {
  currentCleanPath = `/${currentCleanPath}`;
}

// Current query param for category
const currentCategory = url.searchParams.get('category');

// Top Secondary Navigation
const topNavItems = [
  { href: translatePath('/about'), label: t('nav.about'), isActive: currentCleanPath.startsWith('/about') },
  { href: translatePath('/contacts'), label: t('nav.contacts'), isActive: currentCleanPath.startsWith('/contacts') },
  { href: translatePath('/blog'), label: t('nav.blog'), isActive: currentCleanPath.startsWith('/blog') },
  { href: translatePath('/faq'), label: t('nav.faq'), isActive: currentCleanPath.startsWith('/faq') },
];

// Main Catalog Categories
const categoryItems = [
  {
    href: translatePath('/catalog?category=bracelets'),
    label: t('cat.bracelets'),
    isActive: currentCleanPath.startsWith('/catalog') && currentCategory === 'bracelets',
  },
  {
    href: translatePath('/catalog?category=rings'),
    label: t('cat.rings'),
    isActive: currentCleanPath.startsWith('/catalog') && currentCategory === 'rings',
  },
  {
    href: translatePath('/catalog?category=phone-charms'),
    label: t('cat.phone_charms'),
    isActive: currentCleanPath.startsWith('/catalog') && currentCategory === 'phone-charms',
  },
  {
    href: translatePath('/catalog?category=keychains'),
    label: t('cat.keychains'),
    isActive: currentCleanPath.startsWith('/catalog') && currentCategory === 'keychains',
  },
  {
    href: translatePath('/catalog?category=other'),
    label: t('cat.other'),
    isActive: currentCleanPath.startsWith('/catalog') && currentCategory === 'other',
  },
];
---

<header class="site-header-wrapper">
  <div class="site-header">
    <!-- ====================================================================
         UPPER HEADER: Right-aligned clean text links + Language dropdown
         ==================================================================== -->
    <div class="header-top">
      <nav class="header-top__nav" aria-label="Secondary Navigation">
        {topNavItems.map((item) => (
          <a href={item.href} class={item.isActive ? 'active' : ''}>
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Language Dropdown Menu -->
      <div class="lang-dropdown-wrapper" id="lang-dropdown-wrapper">
        <button
          type="button"
          class="lang-dropdown-toggle"
          id="lang-dropdown-toggle"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>🌐</span>
          <span>{t('nav.language')}</span>
          <span class="lang-arrow">▾</span>
        </button>

        <div class="lang-dropdown-menu" id="lang-dropdown-menu" role="menu">
          {(Object.keys(languages) as (keyof typeof languages)[]).map((langKey) => {
            const lang = languages[langKey];
            const isCurrent = currentLang === langKey;
            const targetUrl = translatePath(currentCleanPath, langKey);
            return (
              <a
                href={targetUrl}
                class:list={['lang-option', { active: isCurrent }]}
                role="menuitem"
              >
                <span>{lang.flag}</span>
                <span>{lang.nativeName}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <!-- ====================================================================
         LOWER HEADER: Floating Brand Bar with Medallion and 3 Categories
         ==================================================================== -->
    <div class="header-bottom">
      <!-- Brand / Logo -->
      <a class="header__logo" href={translatePath('/')} aria-label="BunnyBearBeads Home">
        <img
          class="header__medallion"
          src="/emblem-squared.png"
          alt="BunnyBearBeads Logo Medallion"
          width="96"
          height="96"
        />
        <div class="header__brand">
          BunnyBear<Accent>Beads</Accent>
        </div>
      </a>

      <!-- Three Main Catalog Categories -->
      <nav class="header__categories" aria-label="Catalog Categories">
        <ul class="category-links">
          {categoryItems.map((cat) => (
            <li>
              <a href={cat.href} class={cat.isActive ? 'active' : ''}>
                {cat.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Search Button & Cart -->
      <div class="header-bottom__actions">
        <!-- Search Button (Mockup action) -->
        <button
          type="button"
          class="search-toggle-btn"
          id="search-toggle-btn"
          aria-label="Search Catalog"
          title={t('search.label')}
          onclick="const q = prompt('Search / Поиск по каталогу:'); if (q) window.location.href = '/catalog?q=' + encodeURIComponent(q);"
        >
          <svg
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <!-- Cart / Catalog Link -->
        <a
          href={translatePath('/catalog')}
          class="nav-cart-icon"
          aria-label="View Collections / Bag"
          title="Catalog / Bag"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </a>

        <!-- Mobile Hamburger Button -->
        <button
          type="button"
          class="mobile-toggle"
          id="mobile-nav-toggle"
          aria-expanded="false"
          aria-controls="mobile-nav-menu"
          aria-label="Toggle navigation menu"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div class="mobile-menu" id="mobile-nav-menu">
      <div class="mobile-section-title">Каталог / Categories</div>
      <ul class="category-links">
        {categoryItems.map((cat) => (
          <li>
            <a href={cat.href} class={cat.isActive ? 'active' : ''}>
              {cat.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="mobile-section-title" style="margin-top: 12px;">Меню сайта / Site Menu</div>
      <ul class="header-top__nav">
        {topNavItems.map((item) => (
          <li>
            <a href={item.href} class={item.isActive ? 'active' : ''}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="mobile-section-title" style="margin-top: 12px;">Язык / Language</div>
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        {(Object.keys(languages) as (keyof typeof languages)[]).map((langKey) => {
          const lang = languages[langKey];
          const isCurrent = currentLang === langKey;
          const targetUrl = translatePath(currentCleanPath, langKey);
          return (
            <a
              href={targetUrl}
              class:list={['lang-option', { active: isCurrent }]}
              style="padding: 6px 12px; background: rgba(0,0,0,0.05);"
            >
              <span>{lang.flag}</span>
              <span>{lang.nativeName}</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const mobileMenu = document.getElementById('mobile-nav-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('open');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
    });
  }

  // Language dropdown toggle on click (supports touch/mobile)
  const langToggle = document.getElementById('lang-dropdown-toggle');
  const langWrapper = document.getElementById('lang-dropdown-wrapper');

  if (langToggle && langWrapper) {
    langToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = langWrapper.classList.toggle('open');
      langToggle.setAttribute('aria-expanded', String(isOpen));
    });

    document.addEventListener('click', (e) => {
      if (!langWrapper.contains(e.target as Node)) {
        langWrapper.classList.remove('open');
        langToggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
