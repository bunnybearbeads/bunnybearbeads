---
import './Window.css';
import Icon from '../Icon/Icon.astro';

interface Props {
  heading?: string;
  floatedCrossButton?: boolean;
  class?: string;
}

const { heading, floatedCrossButton, class: className } = Astro.props;
---

<div class:list={['window', { 'window--floated-cross-button': floatedCrossButton }, className]}>
  <button class="window__close" type="button" data-hystclose aria-label="Close">
    <Icon name="close" />
  </button>
  {heading && (
    <div class="window__heading">
      {heading}
    </div>
  )}
  <div class="window__body">
    <slot />
  </div>
</div>
