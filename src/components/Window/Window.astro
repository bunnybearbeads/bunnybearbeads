---
import './Window.css';
import Icon from '../Icon/Icon.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  /** Заголовок окна — строкой; выводится <h3 class="window__title"> в начале тела */
  title?: string;
  /** id заголовка — на него ссылается aria-labelledby у HystModal */
  titleId?: string;
  floatedCrossButton?: boolean;
  class?: string;
}

const { title, titleId, floatedCrossButton, class: className } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<div class:list={['window', { 'window--floated-cross-button': floatedCrossButton }, className]}>
  <button class="window__close" type="button" data-hystclose aria-label={t('window.close')}>
    <Icon name="close" />
  </button>
  <div class="window__body">
    {title && (
      <h3 class="window__title" id={titleId}>
        {title}
      </h3>
    )}
    <slot />
  </div>
</div>
